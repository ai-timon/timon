  const j = await http('GET', '/api/routines');
  process.stdout.write(JSON.stringify(j.routines, null, 2) + '\n');
}

async function cmdRoutineCreate(argv) {
  const name = takeFlag(argv, 'name');
  const agent = takeFlag(argv, 'agent');
  const cron = takeFlag(argv, 'cron');
  const prompt = takeFlag(argv, 'prompt');
  const taskType = takeFlag(argv, 'type');
  const project = takeFlag(argv, 'project');
  const enabledFlag = takeFlag(argv, 'enabled');
  if (!name || !agent || !cron || !prompt) {
    process.stderr.write(
      'usage: timon routine create --name TEXT --agent NAME --cron EXPR --prompt TEXT\n' +
      '       [--type code|review|merge|research|doc|chore] [--project SLUG] [--enabled true|false]\n',
    );
    process.exit(64);
  }
  const body = {
    name, agent_name: agent, prompt, cron_expr: cron,
    task_type: taskType || undefined,
    project: project || undefined,
    enabled: enabledFlag === undefined ? true : enabledFlag !== 'false',
  };
  const j = await http('POST', '/api/routines', body);
  process.stdout.write(JSON.stringify(j.routine, null, 2) + '\n');
  // From a mission: born switched off, the user turns it on.
  if (j.needs_activation) process.stdout.write(`\n${j.message}\n`);
}

async function cmdRoutineUpdate(argv) {
  const id = argv[0];
  if (!id) { process.stderr.write('usage: timon routine update <id> [--name ...] [--cron ...] [--enabled true|false] ...\n'); process.exit(64); }
  const fields = {};
  const name = takeFlag(argv, 'name');
  const agent = takeFlag(argv, 'agent');
  const cron = takeFlag(argv, 'cron');
  const prompt = takeFlag(argv, 'prompt');
  const taskType = takeFlag(argv, 'type');
  const project = takeFlag(argv, 'project');
  const enabledFlag = takeFlag(argv, 'enabled');
  if (name) fields.name = name;
  if (agent) fields.agent_name = agent;
  if (cron) fields.cron_expr = cron;
  if (prompt) fields.prompt = prompt;
  if (taskType) fields.task_type = taskType;
  if (project !== undefined) fields.project = project || null;
  if (enabledFlag !== undefined) fields.enabled = enabledFlag !== 'false';
  const j = await http('PUT', `/api/routines/${id}`, fields);
  process.stdout.write(JSON.stringify(j.routine, null, 2) + '\n');
  if (j.needs_activation) process.stdout.write(`\n${j.message}\n`);
}

async function cmdRoutineDelete(argv) {
  const id = argv[0];
  if (!id) { process.stderr.write('usage: timon routine delete <id>\n'); process.exit(64); }
  await http('DELETE', `/api/routines/${id}`);
  process.stdout.write(`routine ${id} deleted\n`);
}

