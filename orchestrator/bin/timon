async function cmdPipelineCreate(argv) {
  const name = takeFlag(argv, 'name');
  const description = takeFlag(argv, 'description');
  const file = takeFlag(argv, 'file');
  if (!name || !file) {
    process.stderr.write(
      'usage: timon pipeline create --name TEXT --file PATH [--description D]\n' +
      '       (--file points to a JSON file with the pipeline definition: { steps: [...] })\n',
    );
    process.exit(64);
  }
  const def = JSON.parse(fs.readFileSync(file, 'utf8'));
  const j = await http('POST', '/api/pipelines', {
    name,
    description: description || undefined,
    definition: def,
  });
  process.stdout.write(JSON.stringify(j.pipeline, null, 2) + '\n');
}

async function cmdPipelineRun(argv) {
  const id = argv.shift();
  const inputRaw = takeFlag(argv, 'input');
  const inputFile = takeFlag(argv, 'input-file');
  if (!id) { process.stderr.write('usage: timon pipeline run <id> [--input JSON | --input-file PATH]\n'); process.exit(64); }
  let input = {};
  if (inputFile) input = JSON.parse(fs.readFileSync(inputFile, 'utf8'));
  else if (inputRaw) input = JSON.parse(inputRaw);
  const j = await http('POST', `/api/pipelines/${encodeURIComponent(id)}/run`, { input });
  process.stdout.write(JSON.stringify(j, null, 2) + '\n');
}

