#!/usr/bin/env node
/**
 * `timon` — tiny CLI exposed to every agent running inside the orchestrator
 * container. Lets agents discover their peers, spawn sub-missions, exchange
 * messages, and watch the result. Uses the selected daemon over HTTP.
 *
 *   timon list                          → JSON array of agents (with project)
 *   timon spawn <agent> <input...>      → JSON {mission_id, …}
 *   timon send <mission_id> <input...>  → JSON {ok:true}
 *   timon steer <mission_id> <input...> → redirects the running turn
 *   timon wait <mission_id> [--timeout=120]  → final assistant text (blocks until end of turn)
 *   timon status <mission_id>           → JSON mission detail
 *   timon kill <mission_id>             → JSON {ok:true}
 *
 * Use --json to force machine-readable output. Default: pretty for humans
 * (still single-line JSON for spawn/send/kill, which is parseable enough).
 */
'use strict';

// Static import required: `orchestrator/package.json` declares
// `"type": "module"`, and this file is resolved via its real path (symlink
// ~/.local/bin/timon) → Node loads it as ESM, where `require` doesn't exist.
// `require('node:fs')` call-sites therefore threw "require is not defined",
// silently breaking --comment-file / --prompt-file / --input-file: a
// reviewer trying to post a long done_comment via file would die without a
// verdict, and its task would go BLOCKED (incident 07/30, task afe70839).
import fs from 'node:fs';
import { execFileSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { homedir, hostname, userInfo } from 'node:os';
import { dirname, join, resolve as resolvePath } from 'node:path';
import { isLocalDaemonUrl, resolveApiUrl } from './cli-api.mjs';
import { isBundledNode, packagedLauncher } from './cli-runtime.mjs';
import { aiToolLines, isDaemonUnreachable, isLoopbackHost, listenUrl, overviewLines, unreachableLines } from './cli-guide.mjs';
import { readAvatarFile } from './avatar-file.mjs';
import { installConsoleAscii } from './console-ascii.mjs';
import { PRESERVED_ON_REWRITE } from './mcp-tools-agents.mjs';
import { cmdDevice } from './cli-device.mjs';
import { cmdAgentExport, cmdAgentExportSkill, cmdAgentImport } from './cli-agent-transfer.mjs';
import { backendProfilesReport, cmdBackend, formatBackendProfiles } from './cli-backend.mjs';
import { PROMPT_CANCELLED, readHiddenLine } from './cli-prompt.mjs';
import { spawnSync } from 'node:child_process';

// An OEM-code-page Windows console garbles UTF-8 (TIM-0114): ASCII there.
installConsoleAscii();

/** Run by a desktop package's runtime (Electron as Node, or the Node it ships), not a source checkout's Node. */
const PACKAGED_RUNTIME = Boolean(process.versions.electron) || isBundledNode(process.execPath);

// Inside a desktop package, only the app's runtime can load the native modules.
{
  const launcher = packagedLauncher(fileURLToPath(import.meta.url));
  if (launcher) {
    const r = spawnSync(launcher, process.argv.slice(2), { stdio: 'inherit', env: { ...process.env, TIMON_CLI_REEXEC: '1' } });
    process.exit(r.status ?? 1);
  }
}

let API;
/** Bearer token: `TIMON_API_TOKEN`, `--daemon <name>` profile, or `daemon-token`. */
let API_TOKEN;

const DAEMON_NAME_RE = /^[A-Za-z0-9._@+-]+$/;

function timonHome() {
  return process.env.TIMON_HOME || join(homedir(), '.timon');
}

function daemonTokenPath() {
  return join(timonHome(), 'daemon-token');
}

function cliDaemonsPath() {
  return join(timonHome(), 'cli-daemons.json');
}

/**
 * Inside a mission the daemon-token is never a fallback: it is the operator's
 * credential, and an agent that fell back to it would be indistinguishable
 * from a terminal — no mission identity for the delegation list to apply.
 * The mission's own `TIMON_API_TOKEN` is the only credential it may use.
 */
function readDaemonTokenFile() {
  if (process.env.TIMON_MISSION_ID) return undefined;
  try {
    const t = fs.readFileSync(daemonTokenPath(), 'utf8').trim();
    return t.length > 0 ? t : undefined;
  } catch {
    return undefined;
  }
}

/** env > local file, the file only for this home's own listener. A named
 *  profile sets its own token instead. */
function resolveApiToken(apiUrl) {
  const env = process.env.TIMON_API_TOKEN;
  if (typeof env === 'string' && env.trim().length > 0) return env.trim();
  return isLocalDaemonUrl(timonHome(), apiUrl, { packaged: packagedCli() }) ? readDaemonTokenFile() : undefined;
}

/** The CLI runs on the package's runtime (its launcher, or Electron as Node). */
function packagedCli() {
  return Boolean(process.versions.electron) || isBundledNode(process.execPath);
}

/** `timon service install` and the onboarding leave this marker once a service is registered. */
function serviceInstalledMarker() {
  return fs.existsSync(join(timonHome(), 'desktop-runtime', 'installed'));
}

/**
 * `timon` alone: where this installation stands and the one command to type
 * next, instead of the whole help. Every probe is short and optional: a
 * missing daemon is a state to describe, not an error.
 */
async function cmdOverview(remote) {
  const local = !remote && isLocalDaemonUrl(timonHome(), API, { packaged: packagedCli() });
  const state = { api: API, local, reachable: false, serviceInstalled: local && serviceInstalledMarker(), version: null };
  try {
    const { timonVersion } = await loadDist('data-version');
    state.version = timonVersion();
  } catch { /* A CLI without its compiled sources still prints the rest. */ }
  state.reachable = await daemonAnswers();
  if (state.reachable) {
    try {
      const me = await httpRaw('GET', '/api/auth/me', undefined, 2500);
      if (me.ok && typeof me.body?.needsSetup === 'boolean') state.needsSetup = me.body.needsSetup;
    } catch { /* Account state unknown. */ }
  }
  if (local) Object.assign(state, await localWebInterface(state.version));
  process.stdout.write(overviewLines(state).join('\n') + '\n');
}

/** This machine's web interface when its daemon serves it, and the SSH session to tunnel from. */
async function localWebInterface(version) {
  const found = { appUrl: null, appLocalOnly: true, ssh: null };
  try {
    // The packaged first-launch ports reach the config through the
    // environment, as for `timon service`.
    const { markPackagedCli } = await loadDist('host/service-environment');
    const { TIMON_HOME } = await loadDist('paths');
    markPackagedCli(process.env, process.versions, version ?? 'current', TIMON_HOME);
    const { appStatus } = await loadDist('plugins-bundled/web-app/control');
    const app = appStatus();
    if (app.state === 'running') {
      found.appUrl = listenUrl(app.listen);
      found.appLocalOnly = isLoopbackHost(app.listen?.host);
    }
  } catch { /* No web interface to show. */ }
  if (process.env.SSH_CONNECTION) found.ssh = { user: userInfo().username, host: hostname() };
  return found;
}

async function daemonAnswers(timeoutMs = 2500) {
  try {
    const r = await fetch(`${API}/api/health`, { headers: timonHeaders(), signal: AbortSignal.timeout(timeoutMs) });
    const body = await r.json().catch(() => null);
    return r.ok && body?.ok === true;
  } catch {
    return false;
  }
}

const EMAIL_SHAPE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
const MIN_PASSWORD = 8;

/** One visible line from the terminal; '' on an empty answer. */
async function askLine(question) {
  const { createInterface } = await import('node:readline/promises');
  const rl = createInterface({ input: process.stdin, output: process.stderr });
  try {
    return (await rl.question(question)).trim();
  } finally {
    rl.close();
  }
}

/**
 * `timon init` — finish an installation from the terminal: the background
 * service if it is missing, the first account, the AI tools. For a server
 * reached over SSH, where the web form would need a tunnel first.
 *
 * The account goes through `POST /api/auth/setup` with the daemon token, the
 * path the route keeps for the operator: holding the token proves a shell on
 * this machine, so neither the one-time setup token nor the email code is
 * asked. The password is typed hidden, or piped with --password-stdin; never
 * an argument, which any process could read.
 */
async function cmdInit(argv, remote) {
  const usage = 'usage: timon init [--email ADDRESS] [--name NAME] [--password-stdin] [--yes]\n';
  const email0 = takeFlag(argv, 'email');
  const name0 = takeFlag(argv, 'name');
  const passwordStdin = argv.includes('--password-stdin');
  const yes = argv.includes('--yes') || argv.includes('-y');
  const unknown = argv.filter((a) => !['--password-stdin', '--yes', '-y'].includes(a));
  if (unknown.length) { process.stderr.write(`timon init: unknown argument ${unknown[0]}\n${usage}`); process.exit(64); }
  const interactive = Boolean(process.stdin.isTTY) && !passwordStdin;
  if (remote || !isLocalDaemonUrl(timonHome(), API, { packaged: packagedCli() })) {
    process.stderr.write('timon init: run it on the machine where Timon is installed, without --daemon.\n');
    process.exit(64);
  }
  if (process.env.TIMON_MISSION_ID) {
    process.stderr.write('timon init: it is for a person at a terminal, not for an agent mission.\n');
    process.exit(64);
  }

  if (!await daemonAnswers()) {
    if (serviceInstalledMarker()) {
      process.stderr.write(unreachableLines({ api: API, local: true, serviceInstalled: true }).join('\n') + '\n');
      process.exit(1);
    }
    if (!yes) {
      if (!interactive) {
        process.stderr.write(unreachableLines({ api: API, local: true, serviceInstalled: false }).join('\n') + '\n');
        process.stderr.write('  Or run timon init --yes to install it now.\n');
        process.exit(1);
      }
      process.stderr.write('Timon does not run in the background yet.\n');
      const answer = (await askLine('Install the background service now (starts at boot, keeps running after you log out)? [Y/n] ')).toLowerCase();
      if (answer && answer !== 'y' && answer !== 'yes') {
        process.stderr.write('Nothing installed. When you are ready: timon service install, then timon init.\n');
        process.exit(1);
      }
    }
    await cmdService(['install']);
    if (process.exitCode) process.exit(process.exitCode);
    process.stderr.write('Waiting for Timon to start');
    const deadline = Date.now() + 120_000;
    let up = false;
    while (!up && Date.now() < deadline) {
      await new Promise((resolve) => setTimeout(resolve, 2000));
      process.stderr.write('.');
      up = await daemonAnswers();
    }
    process.stderr.write('\n');
    if (!up) {
      process.stderr.write(unreachableLines({ api: API, local: true, serviceInstalled: true }).join('\n') + '\n');
      process.exit(1);
    }
  }

  // The daemon token: only the account that owns this home holds it.
  if (!API_TOKEN) {
    process.stderr.write(`timon init: cannot read ${daemonTokenPath()}. Run it as the account that owns Timon's data.\n`);
    process.exit(1);
  }
  const me = await httpRaw('GET', '/api/auth/me', undefined, 5000);
  if (!me.ok) {
    process.stderr.write(`timon init: the daemon refused to describe its accounts (${me.status}).\n`);
    process.exit(1);
  }
  const web = await localWebInterface(null);
  if (me.body?.needsSetup === false) {
    process.stdout.write('This Timon already has an account.\n');
    for (const line of overviewLines({ api: API, reachable: true, needsSetup: false, ...web }).slice(2)) process.stdout.write(line + '\n');
    return;
  }

  // Collect the account.
  let email = (email0 ?? '').trim().toLowerCase();
  let name = (name0 ?? '').trim();
  let password = '';
  let licenseKey = '';
  if (passwordStdin) {
    password = (await readAllStdin()).replace(/\r?\n$/, '');
    if (!email) { process.stderr.write(`timon init: --password-stdin needs --email\n${usage}`); process.exit(64); }
  } else if (!interactive) {
    process.stderr.write(`timon init: no terminal to type the account in. Pipe the password with --password-stdin and give --email.\n${usage}`);
    process.exit(64);
  }
  if (interactive) {
    process.stderr.write('Create your Timon account. It stays on this machine; the email is only used to reset a forgotten password.\n');
    if (!name0) name = await askLine('First name (your agents call you by it; Enter to skip): ');
    while (!EMAIL_SHAPE.test(email)) {
      if (email) process.stderr.write('  That is not an email address.\n');
      email = (await askLine('Email: ')).toLowerCase();
    }
    for (let attempt = 0; attempt < 3 && !password; attempt++) {
      const first = await readHiddenLine(`Password (at least ${MIN_PASSWORD} characters): `);
      if (first.length < MIN_PASSWORD) { process.stderr.write(`  At least ${MIN_PASSWORD} characters.\n`); continue; }
      const again = await readHiddenLine('Password again: ');
      if (again !== first) { process.stderr.write('  The two passwords differ.\n'); continue; }
      password = first;
    }
    if (!password) { process.stderr.write('timon init: no password set; nothing was created.\n'); process.exit(1); }
    if (me.body?.setupRequiresLicense === true) licenseKey = (await readHiddenLine('Licence key: ')).trim();
  }
  if (!EMAIL_SHAPE.test(email)) { process.stderr.write('timon init: that is not an email address.\n'); process.exit(64); }
  if (password.length < MIN_PASSWORD) { process.stderr.write(`timon init: the password needs at least ${MIN_PASSWORD} characters.\n`); process.exit(64); }
  if (me.body?.setupRequiresLicense === true && !licenseKey) {
    process.stderr.write('timon init: this build needs a licence key to create the first account; run timon init in a terminal.\n');
    process.exit(64);
  }
  // The form's first name is optional too; the account needs a display name.
  if (!name) name = email.split('@')[0];

  const body = { email, name, password, ...(licenseKey ? { licenseMode: 'key', licenseKey } : {}) };
  const r = await fetch(`${API}/api/auth/setup`, {
    method: 'POST',
    headers: { ...timonHeaders(), 'content-type': 'application/json' },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(30_000),
  });
  const answer = await r.json().catch(() => ({}));
  if (r.status !== 201) {
    const why = {
      already_set_up: 'an account was created meanwhile; sign in with it.',
      build_expired: 'this build has expired: install the current version of Timon first.',
      setup_in_progress: 'another account creation is running; try again in a moment.',
      license_invalid: 'the licence key was refused.',
      license_required: 'this build needs a licence key.',
    }[answer?.error] ?? (typeof answer?.error === 'string' ? answer.error : `the daemon answered ${r.status}.`);
    process.stderr.write(`timon init: the account was not created: ${why}\n`);
    process.exit(1);
  }
  process.stdout.write(`\nAccount created for ${email}.\n\n`);

  // The route opened a session for the new account: the AI tools are a
  // superadmin's view, read once with it, then the session is closed.
  const cookie = (r.headers.get('set-cookie') ?? '').split(';')[0];
  if (cookie.startsWith('timon_session=')) {
    try {
      const tools = await fetch(`${API}/api/host/provider-clis`, { headers: { cookie }, signal: AbortSignal.timeout(20_000) });
      if (tools.ok) {
        const listing = await tools.json();
        process.stdout.write(aiToolLines(listing?.backends).join('\n') + '\n\n');
      }
    } catch { /* The web interface shows them too. */ }
    await fetch(`${API}/api/auth/logout`, { method: 'POST', headers: { cookie }, signal: AbortSignal.timeout(5000) }).catch(() => {});
  }

  if (web.appUrl && web.ssh && web.appLocalOnly) {
    const port = new URL(web.appUrl).port || '80';
    process.stdout.write('Meet your main agent in the web interface. From your computer, open a tunnel:\n');
    process.stdout.write(`  ssh -N -L ${port}:127.0.0.1:${port} ${web.ssh.user}@${web.ssh.host}\n`);
    process.stdout.write(`then open http://127.0.0.1:${port} and sign in as ${email}.\n`);
  } else if (web.appUrl) {
    process.stdout.write(`Meet your main agent in the web interface: open ${web.appUrl} and sign in as ${email}.\n`);
  } else {
    process.stdout.write('Meet your main agent in the Timon app, signed in with this account.\n');
  }
}

function isHttpUrl(s) {
  return /^https?:\/\//i.test(s);
}

function stripTrailingSlash(url) {
  return url.replace(/\/+$/, '');
}

function validDaemonName(name) {
  return typeof name === 'string' && DAEMON_NAME_RE.test(name) && !name.includes('..');
}

function loadCliDaemons() {
  try {
    const raw = fs.readFileSync(cliDaemonsPath(), 'utf8');
    const parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
      process.stderr.write('timon: cli-daemons.json malformed (expected object { name: { url, token } })\n');
      process.exit(1);
    }
    return parsed;
  } catch (e) {
    if (e && e.code === 'ENOENT') return {};
    if (e instanceof SyntaxError) {
      process.stderr.write("timon: cli-daemons.json is not valid JSON\n");
      process.exit(1);
    }
    throw e;
  }
}

/**
 * `--daemon <url>`: only reuse the local file token for the local listener.
 * `--daemon <name>`: profile from cli-daemons.json — URL and token of the
 * profile, even if TIMON_API_TOKEN points elsewhere (that's the whole point
 * of the profile).
 */
function applyDaemonTarget(spec) {
  if (isHttpUrl(spec)) {
    API = stripTrailingSlash(spec);
    API_TOKEN = resolveApiToken(spec);
    return;
  }
  if (!validDaemonName(spec)) {
    process.stderr.write(`timon: invalid daemon name '${spec}' (A-Za-z0-9._@+- only)\n`);
    process.exit(64);
  }
  const daemons = loadCliDaemons();
  const profile = daemons[spec];
  if (
    !profile || typeof profile !== 'object'
    || typeof profile.url !== 'string' || typeof profile.token !== 'string'
    || profile.token.length === 0
  ) {
    process.stderr.write(`timon: unknown daemon '${spec}' — timon daemon add ${spec} <url> <token>\n`);
    process.exit(64);
  }
  if (!isHttpUrl(profile.url)) {
    process.stderr.write(`timon: invalid url for profile '${spec}'\n`);
    process.exit(64);
  }
  API = stripTrailingSlash(profile.url);
  API_TOKEN = profile.token;
}

/** Propagates agent identity from the env injected by agent.ts when
 *  spawning the Claude child. Required for /api/messages (message origin).
 *  The Bearer (4.2b) is required as soon as the daemon no longer listens on loopback. */
function timonHeaders() {
  const h = {};
  if (process.env.TIMON_MISSION_ID) h['X-TIMON-Mission'] = process.env.TIMON_MISSION_ID;
  if (process.env.TIMON_AGENT) h['X-TIMON-Agent'] = process.env.TIMON_AGENT;
  if (API_TOKEN) h['Authorization'] = `Bearer ${API_TOKEN}`;
  return h;
}

/** A refusal body as one readable line. A right-check 403 carries `code` (the
 *  stable value for an agent), `reason` (prose) and `hint` (next step); an
 *  override gate answers `{ error, reason }`, a licence gate `{ error, message }`.
 *  Compose them so the caller knows which field to change without digging into
 *  raw JSON. Anything else is printed as received. */
function refusalText(text) {
  try {
    const body = JSON.parse(text);
    if (body && typeof body === 'object') {
      const error = typeof body.error === 'string' ? body.error : 'refused';
      const code = typeof body.code === 'string' ? ` [${body.code}]` : '';
      const why = typeof body.message === 'string' ? body.message
        : typeof body.reason === 'string' ? body.reason : undefined;
      const hint = typeof body.hint === 'string' ? ` Hint: ${body.hint}` : '';
      if (code || why) return `${error}${code}${why ? ` — ${why}` : ''}${hint}`;
    }
  } catch { /* not JSON: print it as is */ }
  return text;
}

async function http(method, path, body) {
  const init = { method, headers: { ...timonHeaders() } };
  if (body !== undefined) {
    init.headers['content-type'] = 'application/json';
    init.body = JSON.stringify(body);
  }
  const r = await fetch(API + path, init);
  const text = await r.text();
  if (!r.ok) {
    process.stderr.write(`timon ${method} ${path} → ${r.status}\n`);
    const line = refusalText(text);
    // The composed line is for a human (or agent) to act on; the raw body
    // stays right after it so a script that parses stderr as JSON keeps working.
    if (line !== text) process.stderr.write(`${line}\n`);
    process.stderr.write(`${text}\n`);
    process.exit(2);
  }
  try {
    return JSON.parse(text);
  } catch {
    return text;
  }
}

/** Variant that doesn't exit on non-2xx — used to probe existence
 *  (404 expected for `agent create`, required for `agent update`). */
async function httpRaw(method, path, body, timeoutMs) {
  const init = { method, headers: { ...timonHeaders() } };
  if (timeoutMs) init.signal = AbortSignal.timeout(timeoutMs);
  if (body !== undefined) {
    init.headers['content-type'] = 'application/json';
    init.body = JSON.stringify(body);
  }
  const r = await fetch(API + path, init);
  const text = await r.text();
  let parsed;
  try { parsed = JSON.parse(text); } catch { parsed = text; }
  return { ok: r.ok, status: r.status, body: parsed };
}

/**
 * Validates `--backend` against the orchestrator's RUNTIME catalog.
 *
 * The backend list is no longer fixed now that third-party profiles exist:
 * it depends on the credentials present when the orchestrator started. The
 * CLI used to compare it against a hardcoded `'claude' | 'codex'`, which
 * made any third-party profile unassignable — you could pick it in chat but
 * not assign it to a task, when that's exactly where it's most useful (a
 * cheap model for review/merge/doc).
 *
 * Deliberate degradation: orchestrator unreachable or unreadable response →
 * let it through. The server revalidates anyway, and refusing locally on
 * the strength of a network blip would be worse than sending the request.
 */
async function assertBackend(cmd, backend) {
  if (!backend) return;
  let ids = null;
  try {
    const r = await fetch(API + '/api/backends/catalog', { headers: timonHeaders() });
    if (r.ok) {
      const j = await r.json();
      if (Array.isArray(j?.backends)) ids = j.backends.map((b) => b.id).filter(Boolean);
    }
  } catch { /* orchestrator unreachable → let the server decide */ }
  if (!ids || ids.length === 0) return;
  if (ids.includes(backend)) return;
  process.stderr.write(
    `timon ${cmd}: unknown backend '${backend}'. Available: ${ids.join(', ')}\n`
    + "(a third-party profile only appears if its credentials were present "
    + "when the orchestrator started — see docs/BACKEND_PROFILES.md)\n",
  );
  process.exit(64);
}

function joinRest(argv, from) {
  return argv.slice(from).join(' ');
}

/** A `user` event that really opens a turn. The backend stream ALSO persists
 *  its tool results as `user` events (a content block of type `tool_result`);
 *  slicing on those would keep only what the agent wrote after its last tool
 *  call — nothing at all, for a turn that ends on a tool use. */
function isTurnStart(event) {
  if (event.type !== 'user') return false;
  const content = event.payload?.message?.content;
  if (!Array.isArray(content)) return true; // plain text prompt
  return !content.some((b) => b && b.type === 'tool_result');
}

/** Assistant text of `events`. `sinceLastTurn` keeps only what was written
 *  after the last user input: when `wait` returns at the end of a turn, a
 *  caller that waits twice on the same mission must not be handed the whole
 *  history again. */
function pickAssistantText(events, sinceLastTurn = false) {
  let scanned = events || [];
  if (sinceLastTurn) {
    let start = 0;
    for (let i = 0; i < scanned.length; i += 1) if (isTurnStart(scanned[i])) start = i + 1;
    scanned = scanned.slice(start);
  }
  const out = [];
  for (const e of scanned) {
    if (e.type !== 'assistant') continue;
    const blocks = e.payload?.message?.content;
    if (!Array.isArray(blocks)) continue;
    for (const b of blocks) if (b.type === 'text' && b.text) out.push(b.text);
  }
  return out.join('\n').trim();
}

async function cmdList() {
  const j = await http('GET', '/api/agents');
  process.stdout.write(JSON.stringify(j.agents || [], null, 2) + '\n');
}

async function cmdSpawn(argv) {
  const idemKey = takeFlag(argv, 'idempotency-key') ?? takeFlag(argv, 'key');
  const extraSkillsRaw = takeFlag(argv, 'extra-skills');
  const extraMcpRaw = takeFlag(argv, 'extra-mcp');
  const allowRaw = takeFlag(argv, 'allow');
  const modelOverride = takeFlag(argv, 'model');
  const backendOverride = takeFlag(argv, 'backend');
  const title = takeFlag(argv, 'title');
  const agent = argv[0];
  const input = joinRest(argv, 1).trim();
  if (!agent || !input) {
    process.stderr.write(
      'usage: timon spawn <agent> <input...> [--idempotency-key <hash>]\n' +
      '       [--model SLUG] [--backend NAME] [--title "Short name"]\n' +
      '       [--extra-skills skill1,skill2] [--extra-mcp mcp1,mcp2]\n' +
      '       [--allow "Bash(timon:*),Read(/tmp/*)"]\n',
    );
    process.exit(64);
  }
  await assertBackend('spawn', backendOverride);
  // From inside a mission, a mission token never holds `missions:spawn`
  // (TIM-0074): the unrestricted POST /api/missions is a guaranteed 403.
  // Route the spawn through /api/missions/delegate instead — parent and owner
  // come from the token (X-TIMON-Mission), not from the body, and the overrides
  // are checked against the caller's own level. Mirrors the MCP `mission_spawn`
  // in-mission branch field for field (agent_name/mission, model/backend,
  // extra_*, idempotency_key). `trace_id` and `source_*` are not sent: the
  // delegate body is `.strict()`, and the child inherits the parent's trace via
  // setMissionLineage → inheritTraceFromLineageStmt, so the parent suffices.
  if (process.env.TIMON_MISSION_ID) {
    const delegated = { agent_name: agent, mission: input };
    if (idemKey) delegated.idempotency_key = idemKey;
    if (extraSkillsRaw) delegated.extra_skills = extraSkillsRaw.split(',').map(s => s.trim()).filter(Boolean);
    if (extraMcpRaw) delegated.extra_mcp_servers = extraMcpRaw.split(',').map(s => s.trim()).filter(Boolean);
    if (allowRaw) delegated.extra_allowed_tools = allowRaw.split(',').map(s => s.trim()).filter(Boolean);
    if (modelOverride) delegated.model = modelOverride;
    if (backendOverride) delegated.backend = backendOverride;
    if (title) delegated.title = title;
    const j = await http('POST', '/api/missions/delegate', delegated);
    process.stdout.write(JSON.stringify(j) + '\n');
    return;
  }
  const body = { agent, input };
  if (process.env.TIMON_TRACE_ID) body.trace_id = process.env.TIMON_TRACE_ID;
  if (idemKey) body.idempotency_key = idemKey;
  if (extraSkillsRaw) body.extra_skills = extraSkillsRaw.split(',').map(s => s.trim()).filter(Boolean);
  if (extraMcpRaw) body.extra_mcp_servers = extraMcpRaw.split(',').map(s => s.trim()).filter(Boolean);
  if (allowRaw) body.extra_allowed_tools = allowRaw.split(',').map(s => s.trim()).filter(Boolean);
  if (modelOverride) body.model_override = modelOverride;
  if (backendOverride) body.backend_override = backendOverride;
  if (title) body.title = title;
  const j = await http('POST', '/api/missions', body);
  process.stdout.write(JSON.stringify(j) + '\n');
}

async function cmdSend(argv) {
  const id = argv[0];
  const input = joinRest(argv, 1).trim();
  if (!id || !input) {
    process.stderr.write('usage: timon send <mission_id> <input...>\n');
    process.exit(64);
  }
  // Real route: /api/agents/:missionId/send (index.ts). The param really is
  // a mission_id despite the /agents prefix — /api/missions/:id/send never
  // existed and returned a 404 HTML page, making `timon send` unusable to
  // steer a mission in flight.
  const j = await http('POST', `/api/agents/${encodeURIComponent(id)}/send`, {
    input: input + '\n',
  });
  process.stdout.write(JSON.stringify(j) + '\n');
}

const STEER_METHODS = {
  live: 'the agent reads the instruction inside the running turn',
  restart: 'the turn was stopped and the instruction opened the next one',
};

async function cmdSteer(argv) {
  const asJson = takeSwitch(argv, 'json');
  const id = argv[0];
  const input = joinRest(argv, 1).trim();
  if (!id || !input) {
    process.stderr.write('usage: timon steer <mission_id> <input...> [--json]\n');
    process.exit(64);
  }
  const j = await http('POST', `/api/missions/${encodeURIComponent(id)}/steer`, { input });
  if (asJson) { process.stdout.write(JSON.stringify(j, null, 2) + '\n'); return; }
  process.stdout.write(`steered ${id}: ${STEER_METHODS[j.method] ?? j.method}\n`);
}

async function cmdStatus(argv) {
  const id = argv[0];
  if (!id) {
    process.stderr.write('usage: timon status <mission_id>\n');
    process.exit(64);
  }
  const j = await http('GET', `/api/missions/${encodeURIComponent(id)}`);
  process.stdout.write(JSON.stringify(j, null, 2) + '\n');
}

async function cmdKill(argv) {
  const id = argv[0];
  if (!id) {
    process.stderr.write('usage: timon kill <mission_id>\n');
    process.exit(64);
  }
  const j = await http('DELETE', `/api/missions/${encodeURIComponent(id)}`);
  process.stdout.write(JSON.stringify(j) + '\n');
}

async function cmdStop(argv) {
  const asJson = takeSwitch(argv, 'json');
  const [kind, name] = argv;
  if ((kind !== 'agent' && kind !== 'project') || !name || argv.length > 2) {
    process.stderr.write('usage: timon stop agent <name> | timon stop project <slug> [--json]\n');
    process.exit(64);
  }
  const j = await http('POST', '/api/stop', { [kind]: name });
  if (asJson) { process.stdout.write(JSON.stringify(j, null, 2) + '\n'); return; }
  const out = [`stopped ${j.scope.kind} ${j.scope.name} (agents: ${j.agents.join(', ') || 'none'})`];
  const section = (label, rows, line) => {
    out.push(`${label}: ${rows.length}`);
    for (const row of rows) out.push(`  ${line(row)}`);
  };
  section('missions killed', j.missions, (m) => `${m.id} ${m.agent} (${m.outcome})`);
  section('inbox messages cancelled', j.messages, (m) => `${m.id} ${m.from_agent} -> ${m.to_agent} [${m.kind}]`);
  section('open requests settled', j.deliveries, (d) => `${d.request_id} (mission ${d.mission_id})`);
  section('tasks blocked', j.tasks, (t) => `${t.id} ${t.agent} was ${t.status}${t.scheduled_at ? ` (scheduled ${new Date(t.scheduled_at).toISOString()})` : ''} — ${t.title}`);
  section('triggers switched off', j.triggers, (t) => `${t.id} ${t.source} — ${t.name}`);
  section('workflow runs cancelled', j.workflow_runs ?? [], (r) => `${r.id} — ${r.workflow}`);
  section('workflows switched off', j.workflows ?? [], (w) => `${w.id} — ${w.workflow}`);
  process.stdout.write(out.join('\n') + '\n');
}

async function cmdWait(argv) {
  const id = argv[0];
  let timeout = 120;
  let asJson = false;
  for (const a of argv.slice(1)) {
    if (a.startsWith('--timeout=')) timeout = Number(a.slice('--timeout='.length));
    else if (a === '--json') asJson = true;
  }
  if (!id) {
    process.stderr.write('usage: timon wait <mission_id> [--timeout=120] [--json]\n');
    process.exit(64);
  }
  const deadline = Date.now() + timeout * 1000;
  // `?view=status` and not the full mission: this loop used to download the
  // whole transcript every 1.5 s (2.2 Mo per call on a long mission).
  const poll = `/api/missions/${encodeURIComponent(id)}?view=status`;
  let last;
  let turnEnded = false;
  while (Date.now() < deadline) {
    last = await http('GET', poll);
    const finished = last.status && last.status !== 'running' && last.status !== 'queued';
    if (finished) break;
    // A persistent backend (claude, grok) keeps its process alive after the
    // turn, until the idle reap: waiting for `status` to move meant waiting ten
    // minutes, or forever. Worse, the pilot blocked here kept a turn active,
    // and the wake-loop defers a return for as long as a turn is active — each
    // was waiting on the other. The end of the turn IS the answer.
    if (last.turn_complete && !last.turn_active) { turnEnded = true; break; }
    await new Promise((r) => setTimeout(r, 1500));
  }
  if (!turnEnded && (!last || last.status === 'running' || last.status === 'queued')) {
    process.stderr.write(`timon wait: timed out after ${timeout}s (still ${last?.status})\n`);
    process.exit(3);
  }
  // The transcript is fetched ONCE, at the end, so `--json` keeps returning
  // exactly what it always returned.
  const full = await http('GET', `/api/missions/${encodeURIComponent(id)}`);
  if (asJson) {
    process.stdout.write(JSON.stringify(full, null, 2) + '\n');
  } else {
    // A turn with no text of its own (it ends on a tool use) must not print
    // an empty line: better the whole history than nothing.
    const turnText = pickAssistantText(full.events, turnEnded);
    process.stdout.write((turnText || pickAssistantText(full.events)) + '\n');
  }
}

function help() {
  process.stdout.write(
    `timon — Timon control plane CLI

Getting started:
  timon                                   where this installation stands, and the next command
  timon init [--email A] [--name N]       finish the setup from the terminal: background service,
             [--password-stdin] [--yes]   first account, AI tools (the password is typed hidden)

Updates (run on the daemon host):
  timon update check [--json]            ask timon-ai.com whether a newer Timon is published
  timon update status                    inspect a pending packaged update
  timon update apply                     move the service onto the installed package
  timon update approve <daemon-version>   approve backup and data migration

Agents & missions:
  timon list                              list agents (json)
  timon spawn <agent> <input...>          start a mission, returns {mission_id}
             [--extra-skills s1,s2]       inject skills for this spawn only
             [--extra-mcp mcp1,mcp2]      inject MCP servers for this spawn only
             [--allow "Bash(timon:*)"]     pre-allow tool patterns for this spawn
             [--title "Short name"]        name the mission in the missions list
  timon send <mission_id> <input...>      send a follow-up to a running mission, without stopping its turn
  timon steer <mission_id> <input...> [--json]
                                         redirect the turn running now: the agent changes course
                                         without waiting for its end
  timon wait <mission_id> [--timeout=120] block until the turn ends, print assistant text
  timon status <mission_id>               full mission detail
  timon kill <mission_id>                 terminate a running mission
  timon stop agent <name> | project <slug> [--json]
                                         technical stop of a scope: kills its running missions,
                                         empties its inbox, settles its open requests without a reply,
                                         blocks its PENDING/IN_PROGRESS tasks, switches off its triggers,
                                         cancels the workflow runs it takes part in and switches off
                                         the workflows that would start new ones
  timon trace <traceId|missionId> [--json]
  timon trace backfill [--days N]         explicitly replay cold events into spans

  timon agent create <name> [flags]       new agent (prompt via --prompt-file or stdin)
  timon agent update <name> [flags]       partial update (omit prompt to leave unchanged)
    flags: --backend NAME          --model SLUG   --permission-mode MODE
           --cwd PATH               --project SLUG
           --skills a,b,c           --mcp-servers a,b   (repeatable or comma-sep)
           --allowed-tools …        --disallowed-tools …   --excluded-mcp-servers …
           --look '{"shape":"round","color":"#d4a373","eyes":"happy","acc":"coffee"}'
                                    (mascot look; --look null clears it)
           --avatar emoji|image|mascot   (head shown; --avatar null = picture, logo, emoji, initial)
    (--skills is the whole checked set, stored as the agent's skill attachments:
     unlisted ones are detached; import mode / exclusion: timon skill attach)
    (deletion: the app or the agent_delete tool; the agent waits in the trash)
  timon agent trash list [--json]         deleted agents, newest first, with their trash id
  timon agent trash restore <id>          puts one back under its name (refused if the name is taken)
  timon agent trash purge <id>            deletes one for good (a person's gesture, refused to a mission)
  timon agent set-scope <name> <scope>   set memory scope (NONE|SESSION|AGENT|GLOBAL)
  timon agent set-avatar <name> <image>  set the profile picture (png/jpg/webp/gif, ≤ 2 MB, inside the cwd)
  timon agent set-avatar <name> --clear  remove it
  timon agent rename <old> <new>          rename an agent and its references (refused if <new>
                                         exists or a mission of <old> is running)
  timon agent doc list <agent>            list the identity docs (*.md at ~/.timon/agents/<agent>/)
  timon agent doc get <agent> <file>      print one (SOUL.md, system-prompt.md…)
  timon agent doc put <agent> <file> [--file PATH]
                                         write one; content from --file or stdin (≤ 2 MB). From a
                                         mission: its own agent, or one it orchestrates
  timon agent doc rm <agent> <file>       delete one (system-prompt.md cannot be deleted)
  timon agent export <name…> | --all [--out FILE] [--force]
                                         chosen agents (or all) to a zip another Timon imports:
                                         prompt, identity docs, rules, skills, MCP servers, routines,
                                         picture, team; secrets by NAME only
  timon agent import <FILE> [--yes] [--accept-cwd] [--prefix P] [--json]
                                         shows what would be created, asks, then imports
                                         (--accept-cwd takes the proposed working directories)
  timon agent import --hermes [PROFILE…] [--yes] [--accept-cwd] [--prefix P] [--json]
                                         the same, read from Hermes on the machine running
                                         Timon (all its profiles, or those named); no zip
  timon agent export-skill [--out FILE] [--force]
                                         prints the timon-export skill: give it to Hermes, Grok Bot
                                         or another agent, which then writes a zip to import

  timon mission summarize <id> [--force]  compress the mission transcript for cross-LLM continuation
  timon mission fork <id> --to <agent> [--message "..."]
                                         spawn a continuation on another agent, seeded with summary
  timon mission search <text…>           full-text search in mission history
             [--agent NAME] [--project SLUG] [--since 7d|ISO] [--until …] [--limit N] [--json]
  timon mission reindex [--batch N]       rebuild the mission search index
  timon mission permission-mode get <id>  permission level of a mission, its source and the levels you may pick
  timon mission permission-mode set <id> <mode>
                                         change it from the next message (plan, default, acceptEdits, auto…;
                                         never above your own level, others need agents:privileged-config)
  timon mission egress <id> [--limit N] [--before ID]
                                         outbound connections the mission made through the egress proxy (off by default)

Skills (~/.timon/skills/<id>/SKILL.md):
  timon skill list                        list installed skills
  timon skill get <id> [--file PATH]      print the SKILL.md body, or a file next to it
  timon skill put <id> [--file PATH]      upsert; content from --file or stdin
         [--create-only]                  never replace: 409 when <id> already exists
  timon skill rm <id>                     delete
  timon skill attach <id> --scope global|project|role|agent [--target T]
         [--mode include|import] [--exclude]
                                          attach a skill: include = one catalogue line (body read
                                          with skill get), import = whole body in the prompt;
                                          --exclude removes a skill inherited from a wider scope
  timon skill detach <attachment-id>      remove an attachment
  timon skill attachments [--scope S] [--target T] [--skill ID]
                                          list attachments (json)
  timon skill resolve <agent>             skills the agent spawns with, mode and origin (json)
  timon skill reads <agent> [--json]      skill_get reads by the agent's missions over 30 days
                                          (a skill never read is absent: compare with resolve)

MCP servers (~/.timon/mcp/<id>.json):
  timon mcp list                          list installed MCP servers
  timon mcp get <id>                      print the full config (json)
  timon mcp put <id> [--file PATH]        upsert; JSON from --file or stdin
                                         (shape: {name?, description?, transport})
  timon mcp rm <id>                       delete

Tasks (Kanban backlog):
  timon task list [--status PENDING|IN_PROGRESS|DONE|BLOCKED]   (TODO = deprecated alias of PENDING)
  timon task get <id>
  timon task create --title TEXT --agent NAME [--type code|review|merge|research|doc|chore] [--project SLUG] [--description D] [--priority 1-5]
                   [--base BRANCH] [--todo TODO_ID] [--plan-group NAME]
                   [--model SLUG] [--permission-mode default|acceptEdits|bypassPermissions]
                   [--fallback-backend NAME|none] [--fallback-model SLUG]
                   [--deps id1,id2] [--scheduled ISO8601]
                   [--extra-skills s1,s2] [--extra-mcp mcp1,mcp2]
                   [--allow "Bash(timon:*),Read(/tmp/*)"]
  timon task done <id> [--comment TEXT | --comment-file PATH | --comment-stdin] [--merged-sha SHA] [--summary TEXT]
  timon task block <id> --reason TEXT
  timon task mark-as-done [id] --comment TEXT|--comment-file PATH|--comment-stdin [--verdict pass|changes_requested] [--merged-sha SHA] [--summary TEXT]
                                               closes THE current mission's task (no id to copy)
  timon task mark-merged <id> --sha SHA [--comment TEXT]
                                               branch merged outside Timon: records its merge commit
  timon task mark-as-failed [id] --reason TEXT closes it as BLOCKED
  timon task update <id> [--status ...] [--priority N] [--title ...] [--agent ...] [--type ...]
  timon task delete <id> [--chain]           --chain: also the verification chain it heads

  timon backends [--json]                      backends and models actually available

Series fallback plan (quota exhausted mid-chantier):
  timon series fallback list [--series ID]     rules in effect (default: THIS mission's series)
  timon series fallback set --scope orchestrator|code|review|merge|doc|chore|*
                           --backend NAME [--model SLUG] [--group NAME] [--series ID] [--no-apply]
                           --backend none    → this scope does not fall back
                           --group NAME      → for ONE group of volets of the plan (read before
                                               the series rule; never with orchestrator)
                           applied at once to the pending tasks of that scope;
                           --no-apply records the rule without moving anything
  timon series fallback clear --scope SCOPE [--group NAME] [--series ID]

Series role choices (who runs, for THIS series only — roles.json untouched):
  timon series role list [--series ID]         choices in effect for the series
  timon series role set --scope code|review|merge|research|doc|chore
                        [--backend NAME] [--model SLUG] [--group NAME] [--series ID]
                        task override > group choice > series role > project role > agent config
                        --group NAME → for ONE group of volets of the plan (tasks created
                                       with --plan-group NAME, and their chain)
  timon series role clear --scope SCOPE [--group NAME] [--series ID]

Worktrees (git isolation per code task):
  timon worktree info <task-id>                show path/branch/base/merged-sha
  timon worktree create <task-id> [--base B]   force-create (dispatcher does it automatically for type=code)
  timon worktree dispose <task-id> [--force]   unmounts worktree + local branch (post-merge)

Projects (agent roles per project):
  timon project list                           lists configured projects
  timon project roles <slug>                   shows the role→agent mapping
  timon project set-role <slug> <role> <agent> [--model SLUG] [--permission-mode MODE]
                                             sets the agent + model/permission for a role
  timon project create <slug> [--name TEXT] [--cwd PATH] [--workspace NAME] [--create-workspace]
