      process.exit(64);
  }
}

/* ─── triggers ─── */
function takeAll(argv, name) {
  const values = [];
  for (let v = takeFlag(argv, name); v !== undefined; v = takeFlag(argv, name)) values.push(v);
  return values;
}

function takeSwitch(argv, name) {
  const i = argv.indexOf('--' + name);
  if (i === -1) return false;
  argv.splice(i, 1);
  return true;
}

function parseJsonFlag(label, raw) {
  try { return JSON.parse(raw); } catch (err) {
    process.stderr.write(`--${label}: invalid JSON (${err.message})\n`);
    process.exit(64);
  }
}

/** A trigger is addressed by id, or by the slug of a webhook. */
async function resolveTriggerId(ref) {
  if (/^[0-9a-f-]{36}$/.test(ref)) return ref;
  const j = await http('GET', '/api/triggers');
  const hit = j.triggers.find((t) => t.slug === ref || t.id === ref);
  if (!hit) { process.stderr.write(`trigger not found: ${ref}\n`); process.exit(1); }
  return hit.id;
}

async function cmdTriggerList(argv) {
  const source = takeFlag(argv, 'source');
  const j = await http('GET', `/api/triggers${source ? `?source=${encodeURIComponent(source)}` : ''}`);
  process.stdout.write(JSON.stringify(j.triggers, null, 2) + '\n');
}

async function cmdTriggerCreate(argv) {
  const usage = 'usage: timon trigger create --source schedule|webhook|event --name TEXT ' +
    '[--cron EXPR [--tz ZONE] | --slug NAME --auth SCHEME | --event KIND] [--filter JSON] ' +
    '(--action JSON ... | --todo TEXT [--project SLUG] | --notify TITLE | --task-agent NAME --prompt TEXT\n' +
    '  | --script BIN [--arg A ...] --cwd DIR [--env SECRET ...] [--timeout SECONDS] [--allow-overlap] [--no-failure-alert])\n';
  const source = takeFlag(argv, 'source');
  const name = takeFlag(argv, 'name');
  const actions = takeAll(argv, 'action').map((raw) => parseJsonFlag('action', raw));
  const todo = takeFlag(argv, 'todo');
  const project = takeFlag(argv, 'project');
  const notify = takeFlag(argv, 'notify');
  const taskAgent = takeFlag(argv, 'task-agent');
  const prompt = takeFlag(argv, 'prompt');
  if (todo) actions.push({ type: 'todo', text: todo, ...(project ? { project } : {}) });
  if (notify) actions.push({ type: 'notify', title: notify });
  if (taskAgent && prompt) actions.push({ type: 'task', agent: taskAgent, prompt });
  const script = takeFlag(argv, 'script');
  if (script) {
    // argv, no shell: `--script bash --arg -c --arg '…'` when a shell is wanted.
    const cwd = takeFlag(argv, 'cwd');
    if (!cwd) { process.stderr.write('--script needs --cwd DIR (inside a registered project)\n'); process.exit(64); }
    const action = { type: 'script', command: script, cwd: resolvePath(cwd) };
    const args = takeAll(argv, 'arg');
    if (args.length) action.args = args;
    const env = takeAll(argv, 'env');
    if (env.length) action.env = env;
    const timeout = takeFlag(argv, 'timeout');
    if (timeout !== undefined) action.timeout_s = Number(timeout);
    if (takeSwitch(argv, 'allow-overlap')) action.overlap = 'allow';
    if (takeSwitch(argv, 'no-failure-alert')) action.notify_on_failure = false;
    actions.push(action);
  }
  if (!source || !name || actions.length === 0) { process.stderr.write(usage); process.exit(64); }
  const body = { source, name, actions };
  const filter = takeFlag(argv, 'filter');
  if (filter) body.filter = parseJsonFlag('filter', filter);
  const enabled = takeFlag(argv, 'enabled');
  if (enabled !== undefined) body.enabled = enabled !== 'false';
  if (source === 'schedule') {
    const cron = takeFlag(argv, 'cron');
    const tz = takeFlag(argv, 'tz');
    if (!cron) { process.stderr.write(usage); process.exit(64); }
    body.config = { cron, ...(tz ? { tz } : {}) };
  } else if (source === 'webhook') {
    body.slug = takeFlag(argv, 'slug');
    body.config = { auth: takeFlag(argv, 'auth') || 'generic' };
    const secret = takeFlag(argv, 'secret');
    if (secret) body.secret = secret;
  } else if (source === 'event') {
    body.config = { event: takeFlag(argv, 'event') };
  }
  const j = await http('POST', '/api/triggers', body);
  if (!j.trigger && j.proposal_id) {
    // From a mission: a script is a proposal the user approves, never created here.
    process.stdout.write(`proposal ${j.proposal_id} pending\n${j.message}\n`);
    return;
  }
  process.stdout.write(JSON.stringify(j.trigger, null, 2) + '\n');
  // From a mission: born switched off, the user turns it on.
  if (j.needs_activation) process.stdout.write(`\n${j.message}\n`);
  if (j.secret) {
    // Shown once: the daemon never returns it again (rotate to get a new one).
    process.stdout.write(`\nsecret (shown once, give it to the sender): ${j.secret}\n`);
  }
}

async function cmdTriggerTest(argv) {
  const ref = argv.shift();
  if (!ref) { process.stderr.write('usage: timon trigger test <id|slug> [--payload JSON] [--header Name:Value ...] [--execute]\n'); process.exit(64); }
  const payload = takeFlag(argv, 'payload');
  const headers = {};
  for (const raw of takeAll(argv, 'header')) {
    const at = raw.indexOf(':');
    if (at <= 0) { process.stderr.write(`--header: expected Name:Value, got "${raw}"\n`); process.exit(64); }
    headers[raw.slice(0, at).trim()] = raw.slice(at + 1).trim();
  }
  const body = { execute: takeSwitch(argv, 'execute') };
  if (payload) body.payload = parseJsonFlag('payload', payload);
  if (Object.keys(headers).length) body.headers = headers;
  const id = await resolveTriggerId(ref);
  const j = await http('POST', `/api/triggers/${encodeURIComponent(id)}/test`, body);
  process.stdout.write(JSON.stringify(j, null, 2) + '\n');
}

async function cmdTriggerProposals(argv) {
  const status = takeFlag(argv, 'status');
  const j = await http('GET', `/api/triggers/proposals${status ? `?status=${encodeURIComponent(status)}` : ''}`);
  if (!j.proposals.length) { process.stdout.write('no trigger proposal\n'); return; }
  process.stdout.write(JSON.stringify(j.proposals.map((p) => ({
    id: p.id, status: p.status, agent: p.agent, project: p.project, mission: p.missionTitle, note: p.note, trigger: p.payload,
  })), null, 2) + '\n');
}

async function cmdTriggerDecide(decision, argv) {
  const id = argv[0];
  if (!id) { process.stderr.write(`usage: timon trigger ${decision} <proposal-id>\n`); process.exit(64); }
  const j = await http('POST', `/api/triggers/proposals/${encodeURIComponent(id)}/${decision}`);
  if (j.trigger) process.stdout.write(`trigger ${j.trigger.id} created (${j.trigger.name})\n`);
  else process.stdout.write(`proposal ${id} ${j.proposal.status}\n`);
}

async function cmdTriggerRemove(argv) {
  const ref = argv[0];
  if (!ref) { process.stderr.write('usage: timon trigger remove <id|slug>\n'); process.exit(64); }
  const id = await resolveTriggerId(ref);
  await http('DELETE', `/api/triggers/${encodeURIComponent(id)}`);
  process.stdout.write(`trigger ${id} removed\n`);
}

async function cmdTrigger(argv) {
  const [sub, ...rest] = argv;
  switch (sub) {
    case 'list':   return cmdTriggerList(rest);
    case 'create': return cmdTriggerCreate(rest);
    case 'test':   return cmdTriggerTest(rest);
    case 'proposals': return cmdTriggerProposals(rest);
    case 'approve': return cmdTriggerDecide('approve', rest);
    case 'reject':  return cmdTriggerDecide('reject', rest);
    case 'remove':
    case 'rm':     return cmdTriggerRemove(rest);
    default:
      process.stderr.write('usage: timon trigger <list|create|test|remove|proposals|approve|reject> …\n');
      process.exit(64);
  }
}

/* ─── workflows ─── */
async function cmdWorkflow(argv) {
  const [sub, ...rest] = argv;
  if (sub === 'list') { const j = await http('GET', '/api/workflows'); process.stdout.write(JSON.stringify(j.workflows, null, 2) + '\n'); return; }
  if (sub === 'get') { if (!rest[0]) throw new Error('usage: timon workflow get <slug>'); const j = await http('GET', `/api/workflows/${encodeURIComponent(rest[0])}`); process.stdout.write(JSON.stringify(j.workflow, null, 2) + '\n'); return; }
  if (sub === 'create') { const file = takeFlag(rest, 'file'); if (!file) throw new Error('usage: timon workflow create --file FILE'); const fs = await import('node:fs/promises'); const body = JSON.parse(await fs.readFile(file, 'utf8')); const j = await http('POST', '/api/workflows', body); process.stdout.write(JSON.stringify(j.workflow, null, 2) + '\n'); return; }
  if (sub === 'publish') { if (!rest[0]) throw new Error('usage: timon workflow publish <slug>'); const j = await http('POST', `/api/workflows/${encodeURIComponent(rest[0])}/publish`); process.stdout.write(JSON.stringify(j, null, 2) + '\n'); return; }
  if (sub === 'run') { const slug = rest[0]; const input = takeFlag(rest, 'input'); if (!slug) throw new Error('usage: timon workflow run <slug> [--input JSON]'); const j = await http('POST', `/api/workflows/${encodeURIComponent(slug)}/run`, { input: input ? JSON.parse(input) : {} }); process.stdout.write(JSON.stringify(j.run, null, 2) + '\n'); return; }
  if (sub === 'runs') { if (!rest[0]) throw new Error('usage: timon workflow runs <slug>'); const j = await http('GET', `/api/workflows/${encodeURIComponent(rest[0])}/runs`); process.stdout.write(JSON.stringify(j.runs, null, 2) + '\n'); return; }
  if (sub === 'status') { if (!rest[0]) throw new Error('usage: timon workflow status <runId>'); const j = await http('GET', `/api/workflows/runs/${encodeURIComponent(rest[0])}`); process.stdout.write(JSON.stringify(j, null, 2) + '\n'); return; }
  if (sub === 'cancel') { if (!rest[0]) throw new Error('usage: timon workflow cancel <runId>'); const j = await http('POST', `/api/workflows/runs/${encodeURIComponent(rest[0])}/cancel`); process.stdout.write(JSON.stringify(j, null, 2) + '\n'); return; }
  if (sub === 'import') { const kind = rest[0]; const id = rest[1]; if (!id || !['pipeline', 'agent', 'routine'].includes(kind)) throw new Error('usage: timon workflow import <pipeline|agent|routine> <id>'); const j = await http('POST', `/api/workflows/import/${kind}/${encodeURIComponent(id)}`); process.stdout.write(JSON.stringify(j.workflow, null, 2) + '\n'); return; }
  if (sub === 'node' && rest[0] === 'done') { const output = takeFlag(rest, 'output'); const route = takeFlag(rest, 'route'); const runId = process.env.TIMON_WORKFLOW_RUN_ID; const nodeId = process.env.TIMON_WORKFLOW_NODE_ID; if (!runId || !nodeId || !output) throw new Error('usage: timon workflow node done --output JSON [--route PORT]'); const j = await http('POST', `/api/workflows/runs/${encodeURIComponent(runId)}/nodes/${encodeURIComponent(nodeId)}/done`, { output: JSON.parse(output), ...(route ? { route } : {}) }); process.stdout.write(JSON.stringify(j, null, 2) + '\n'); return; }
  throw new Error('usage: timon workflow <list|get|create|publish|run|runs|status|cancel|import|node done> …');
}

/* ─── project-todo (a project's idea notebook: nothing here is ever dispatched) ─── */
async function cmdProjectTodoList(argv) {
  const status = takeFlag(argv, 'status');
  const project = takeFlag(argv, 'project');
  const qs = [];
  if (status) qs.push(`status=${encodeURIComponent(status)}`);
  if (project) qs.push(`project=${encodeURIComponent(project)}`);
  const j = await http('GET', `/api/project-todo${qs.length ? '?' + qs.join('&') : ''}`);
  if (argv.includes('--json')) {
    process.stdout.write(JSON.stringify(j.items, null, 2) + '\n');
    return;
  }
  for (const it of j.items || []) {
    const box = it.status === 'done' ? '[x]' : '[ ]';
    const proj = it.project ? ` (${it.project})` : '';
    process.stdout.write(`${box} ${it.id}. ${it.text}${proj}\n`);
    if (it.notes) process.stdout.write(`      ${it.notes}\n`);
  }
  process.stdout.write(`\n${j.open ?? 0} open idea(s)\n`);
}

async function cmdProjectTodoAdd(argv) {
  const project = takeFlag(argv, 'project');
  const notes = takeFlag(argv, 'notes');
  const text = joinRest(argv, 0).trim();
  if (!text) {
    process.stderr.write('usage: timon project-todo add <text...> [--project SLUG] [--notes TEXT]\n');
    process.exit(64);
  }
  const body = { text };
  if (project) body.project = project;
  if (notes) body.notes = notes;
  const j = await http('POST', '/api/project-todo', body);
  process.stdout.write(JSON.stringify(j.item, null, 2) + '\n');
}

async function cmdProjectTodoUpdate(argv) {
  const id = argv.shift();
  const project = takeFlag(argv, 'project');
  const notes = takeFlag(argv, 'notes');
  const status = takeFlag(argv, 'status');
  const text = takeFlag(argv, 'text') ?? (joinRest(argv, 0).trim() || undefined);
  if (!id) {
    process.stderr.write('usage: timon project-todo update <id> [<text...>] [--text TEXT] [--project SLUG] [--notes TEXT] [--status open|done]\n');
    process.exit(64);
  }
  const fields = {};
  if (text !== undefined) fields.text = text;
  if (project !== undefined) fields.project = project;
  if (notes !== undefined) fields.notes = notes;
  if (status !== undefined) fields.status = status;
  const j = await http('PATCH', `/api/project-todo/${encodeURIComponent(id)}`, fields);
  process.stdout.write(JSON.stringify(j.item, null, 2) + '\n');
}

async function cmdProjectTodoDone(argv) {
  const id = argv[0];
  if (!id) { process.stderr.write('usage: timon project-todo done <id> [--undo]\n'); process.exit(64); }
  const status = argv.includes('--undo') ? 'open' : 'done';
  const j = await http('PATCH', `/api/project-todo/${encodeURIComponent(id)}`, { status });
  process.stdout.write(JSON.stringify(j.item, null, 2) + '\n');
}

/**
 * Promotion: the idea becomes a PENDING task. The only gesture of the notebook that
 * creates dispatchable work — hence the required agent, never guessed.
 */
async function cmdProjectTodoPromote(argv) {
  const id = argv.shift();
  const agent = takeFlag(argv, 'agent') ?? takeFlag(argv, 'agent-name');
  const type = takeFlag(argv, 'type');
  const priority = takeFlag(argv, 'priority');
  const base = takeFlag(argv, 'base');
  const pipeline = takeFlag(argv, 'pipeline');
  const project = takeFlag(argv, 'project');
  if (!id || !agent) {
    process.stderr.write('usage: timon project-todo promote <id> --agent NAME [--type TYPE] [--priority N] [--base REF] [--pipeline P] [--project SLUG]\n');
    process.exit(64);
  }
  const body = { agent_name: agent };
  if (type) body.type = type;
  if (priority) body.priority = Number(priority);
  if (base) body.base = base;
  if (pipeline) body.pipeline = pipeline;
  if (project) body.project = project;
  const j = await http('POST', `/api/project-todo/${encodeURIComponent(id)}/promote`, body);
  process.stdout.write(JSON.stringify(j, null, 2) + '\n');
}

async function cmdProjectTodoDelete(argv) {
  const id = argv[0];
  if (!id) { process.stderr.write('usage: timon project-todo rm <id>\n'); process.exit(64); }
  await http('DELETE', `/api/project-todo/${encodeURIComponent(id)}`);
  process.stdout.write(`project-todo ${id} deleted\n`);
}

async function cmdProjectTodo(argv) {
  const [sub, ...rest] = argv;
  switch (sub) {
    case 'list':   return cmdProjectTodoList(rest);
    case 'add':    return cmdProjectTodoAdd(rest);
    case 'update': return cmdProjectTodoUpdate(rest);
    case 'done':   return cmdProjectTodoDone(rest);
    case 'promote': return cmdProjectTodoPromote(rest);
    case 'rm':
    case 'delete': return cmdProjectTodoDelete(rest);
    default:
      process.stderr.write('usage: timon project-todo <list|add|update|done|promote|rm> …\n');
      process.exit(64);
  }
}

/* ─── memory rule: DIRECT write to memory_rules ────────────────────────────
   This is the canonical way to memorize. Writing to `pieges.md` is NOT
   enough: that file is only imported at the very first bootstrap of the
   database (memory-migrate.ts, "table is empty" branch), never replayed since. */

/** Default target of a scope=agent rule: the agent running the command. */
function currentAgentName() {
  return process.env.TIMON_AGENT || null;
}

function ruleLine(r) {
  const cible = r.scope === 'agent' ? r.agent : r.scope === 'project' ? r.project : r.scope === 'role' ? r.role : '—';
  const tier = r.tier && r.tier !== 'normal' ? ` [${r.tier}]` : '';
  const st = r.status && r.status !== 'active' ? ` (${r.status})` : '';
  return `[${r.id}] ${r.scope}:${cible} ${r.kind}${tier}${st}\n  ${r.text}\n`;
}

async function cmdMemoryRule(argv) {
  const sub = argv[0];
  const rest = argv.slice(1);

  if (sub === 'add') {
    const scope = (takeFlag(rest, 'scope') || 'agent').trim();
    const kind = (takeFlag(rest, 'kind') || 'pitfall').trim();
    const tier = takeFlag(rest, 'tier');
    let agent = takeFlag(rest, 'agent');
    let project = takeFlag(rest, 'project');
    const role = takeFlag(rest, 'role');
    const json = rest.includes('--json') ? (rest.splice(rest.indexOf('--json'), 1), true) : false;
    // A long text doesn't survive argv well (shell quoting) — same escape
    // hatch as `task done --comment-file`.
    const textFile = takeFlag(rest, 'text-file');
    let text = joinRest(rest, 0).trim();
    if (!text && textFile) text = fs.readFileSync(textFile, 'utf8').trim();
    if (!text && !process.stdin.isTTY) text = (await readAll(process.stdin)).trim();
    if (!text) {
      process.stderr.write('usage: timon memory rule add <text…> [--scope agent|project|role|global] [--agent NAME] [--project SLUG] [--role ROLE] [--kind pitfall|decision|preference] [--tier normal|core]\n');
      process.exit(64);
    }
    // Defaults inferred from execution context: an agent noting a pitfall
    // about itself has nothing to specify.
    if (scope === 'agent' && !agent) agent = currentAgentName();
    if (scope === 'project' && !project) project = process.env.TIMON_PROJECT || undefined;
    if (scope === 'agent' && !agent) {
      process.stderr.write("timon memory rule add: scope=agent and TIMON_AGENT missing — specify --agent NAME\n");
      process.exit(64);
    }
    if (scope === 'project' && !project) {
      process.stderr.write("timon memory rule add: scope=project and TIMON_PROJECT missing — specify --project SLUG\n");
      process.exit(64);
    }
    const body = { scope, kind, text };
    if (agent) body.agent = agent;
    if (project) body.project = project;
    if (role) body.role = role;
    if (tier) body.tier = tier;
    const r = await httpRaw('POST', '/api/memory/rules', body);
    if (!r.ok) {
      // 409 = exact duplicate: not a failure, but still an error exit
      // (exit ≠ 0) so a script doesn't believe it wrote successfully.
      const msg = (r.body && r.body.error) || JSON.stringify(r.body);
      process.stderr.write(`timon memory rule add: ${msg}\n`);
      process.exit(r.status === 409 ? 3 : 2);
    }
    const rule = r.body.rule;
    if (json) process.stdout.write(JSON.stringify(rule) + '\n');
    else process.stdout.write(`rule #${rule.id} saved (${rule.scope})\n  ${rule.text}\n`);
    return;
  }

  if (sub === 'list') {
    const scope = takeFlag(rest, 'scope');
    let agent = takeFlag(rest, 'agent');
    const project = takeFlag(rest, 'project');
    const json = rest.includes('--json');
    // With no filter at all, show the current agent's rules instead of the
    // ~2000 in the database — a full dump helps nobody in a terminal.
    if (!scope && !agent && !project) agent = currentAgentName() || undefined;
    const qs = new URLSearchParams();
    if (scope) qs.set('scope', scope);
    if (agent) qs.set('agent', agent);
    if (project) qs.set('project', project);
    const j = await http('GET', `/api/memory/rules${qs.toString() ? '?' + qs.toString() : ''}`);
    const rules = j.rules || [];
    if (json) { process.stdout.write(JSON.stringify(rules, null, 2) + '\n'); return; }
    for (const r of rules) process.stdout.write(ruleLine(r));
    process.stdout.write(`\n${rules.length} rule(s)\n`);
    return;
  }

  if (sub === 'rm' || sub === 'delete') {
    const id = rest[0];
    if (!id) { process.stderr.write('usage: timon memory rule rm <id>\n'); process.exit(64); }
    const j = await http('DELETE', `/api/memory/rules/${encodeURIComponent(id)}`);
    process.stdout.write(`rule #${(j.deleted || {}).id ?? id} deleted\n`);
    return;
  }

  process.stderr.write('usage: timon memory rule <add <text…> | list | rm <id>>\n');
  process.exit(64);
}

/* ─── memory (cross-cutting search + read, supervisor view) ─── */
async function cmdMemory(argv) {
  const sub = argv[0];
  if (sub === 'rule') {
    return cmdMemoryRule(argv.slice(1));
  }
  if (sub === 'search') {
    const q = joinRest(argv, 1).trim();
    if (!q) { process.stderr.write('usage: timon memory search <query…>\n'); process.exit(64); }
    const j = await http('GET', `/api/memory/search?q=${encodeURIComponent(q)}`);
    for (const h of j.hits || []) {
      const k = h.kind ? ` (${h.kind})` : '';
      const u = h.uses ? ` ×${h.uses} usages` : '';
      process.stdout.write(`[${h.scope}:${h.id}] ${h.file}${k}${u}\n  ${h.text}\n`);
    }
    process.stdout.write(`\n${j.count || 0} hit(s) ranked by relevance${j.truncated ? ' (truncated)' : ''} for "${q}"\n`);
  } else if (sub === 'overview') {
    const j = await http('GET', '/api/memory/overview');
    const c = j.counts || {};
    process.stdout.write(`Facts: ${c.facts ?? 0} · Pitfalls: ${c.pitfalls ?? 0} · Pending: ${c.pending ?? 0} · Projects: ${c.projects ?? 0}\n`);
    if ((j.proposals || []).length) {
      process.stdout.write(`\nPending proposals:\n`);
      for (const p of j.proposals) process.stdout.write(`  [${p.slug}] ${p.kind} ×${p.count} — ${p.text}\n`);
    }
  } else if (sub === 'show') {
    const [scope, id, file] = argv.slice(1);
    if (scope !== 'project' && scope !== 'agent') {
      process.stderr.write('usage: timon memory show <project|agent> <id> [file]\n'); process.exit(64);
    }
    if (!id) { process.stderr.write('usage: timon memory show <project|agent> <id> [file]\n'); process.exit(64); }
    const base = scope === 'project' ? `/api/projects/${encodeURIComponent(id)}/memory` : `/api/agents/${encodeURIComponent(id)}/memory`;
    if (file) {
      const txt = await http('GET', `${base}/${encodeURIComponent(file)}`);
      process.stdout.write((typeof txt === 'string' ? txt : JSON.stringify(txt, null, 2)) + '\n');
    } else {
      const j = await http('GET', base);
      for (const f of j.files || []) process.stdout.write(`${f.name}\t${f.size} B\n`);
    }
  } else {
    process.stderr.write('usage: timon memory <rule <add|list|rm> | search <query…> | overview | show <project|agent> <id> [file]>\n');
    process.exit(64);
  }
}

async function cmdNotify(argv) {
  const TYPES = ['report', 'alert', 'action_required'];
  const type = argv[0];
  if (!type || !TYPES.includes(type)) {
    process.stderr.write(`usage: timon notify <${TYPES.join('|')}> <title…> [--body TEXT | --body-file PATH | --body-stdin] [--urgent] [--task-id ID] [--mission-id ID] [--dismiss-on reply,task_done] [--ttl MINUTES]\n`);
    process.exit(64);
  }
  const urgent = argv.includes('--urgent');
  if (urgent) argv.splice(argv.indexOf('--urgent'), 1);
  // --body-file / --body-stdin like on `task done`: an end-of-mission report
  // quickly exceeds what an inline `--body` can take without getting
  // truncated by shell quoting. Without these variants, an unknown flag was
  // just silently ignored and the body ended up empty — report lost silently.
  const bodyFile = takeFlag(argv, 'body-file');
  const wantBodyStdin = argv.includes('--body-stdin')
    ? (argv.splice(argv.indexOf('--body-stdin'), 1), true)
    : false;
  let body = takeFlag(argv, 'body') || null;
  if (!body && bodyFile) body = fs.readFileSync(bodyFile, 'utf8');
  else if (!body && wantBodyStdin && !process.stdin.isTTY) body = await readAll(process.stdin);
  const taskId = takeFlag(argv, 'task-id') || takeFlag(argv, 'task_id') || null;
  const missionId = takeFlag(argv, 'mission-id') || takeFlag(argv, 'mission_id') ||
    process.env.TIMON_MISSION_ID || null;
  // action_required only: what closes the card by itself, and its lifetime in
  // minutes. Left unset, the daemon picks (reply in the mission, else 24 h).
  const dismissOnFlag = takeFlag(argv, 'dismiss-on');
  const ttlFlag = takeFlag(argv, 'ttl');
  const lifecycle = {};
  if (dismissOnFlag !== undefined && dismissOnFlag !== null) {
    lifecycle.dismiss_on = String(dismissOnFlag).split(',').map((s) => s.trim()).filter(Boolean);
  }
  if (ttlFlag !== undefined && ttlFlag !== null) {
    const ttl = Number(ttlFlag);
    if (!Number.isInteger(ttl) || ttl < 1) {
      process.stderr.write('timon notify: --ttl takes a whole number of minutes\n');
      process.exit(64);
    }
    lifecycle.ttl_minutes = ttl;
  }
  const title = joinRest(argv, 1).trim();
  if (!title) {
    process.stderr.write('timon notify: title is required\n');
    process.exit(64);
  }
  // The `notifications` module is `std`: it can be switched off. Its routes
  // then vanish and the POST answers 404 (or 503 while stopping). An agent
  // that calls `timon notify` at the end of a task must NOT fail because of
  // that — a missing notification centre is a configuration choice, not a
  // task failure. So a disabled module is a logged no-op (exit 0); any other
  // failure (403, 500, …) still exits non-zero so the caller sees it.
  const r = await httpRaw('POST', '/api/notifications', { type, urgent: urgent ? 1 : 0, title, body, task_id: taskId, mission_id: missionId, ...lifecycle });
  if (r.status === 404 || r.status === 503) {
    process.stdout.write(`notifications module disabled — dropped: ${type} ${title}\n`);
    return;
  }
  if (!r.ok) {
    process.stderr.write(`timon POST /api/notifications → ${r.status}\n${typeof r.body === 'string' ? r.body : JSON.stringify(r.body)}\n`);
    process.exit(2);
  }
  const j = r.body;
  const id = (j.notification || j).id;
  process.stdout.write(`notification created: ${id}\n`);
}

/* ─── embedded browser ──────────────────────────────────────────────────────
   One Chromium container per project, with a PERSISTENT profile (sessions,
   cookies, 2FA already validated). This is the only browser an agent should
   drive: it is wired as the `timon-browser` MCP; the user's own `chrome-devtools`
   (a LOCAL Chrome with no session) is a separate server Timon leaves alone. */

/** Project slug targeted by a `timon browser` command.
 *
 *  Same precedence as `taskProjectSlug` on the orchestrator side: explicit
 *  argument > agent's declared project (injected in env at spawn) > cwd. cwd
 *  comes last because a `code` task runs in a worktree
 *  `~/.timon/worktrees/<id>` from which no slug can be inferred. */
async function browserSlug(argv) {
  const explicit = takeFlag(argv, 'project') ?? (argv[0] && !argv[0].startsWith('-') ? argv.shift() : undefined);
  if (explicit) return explicit;
  if (process.env.TIMON_PROJECT) return process.env.TIMON_PROJECT;

  // A project's slug is NOT its folder name: `acme` may live in `acme-site`,
  // and `blog` be nested under `websites/`. Deriving the slug from the path therefore gave a
  // nonexistent project, and `browser status` answered "STOPPED" on a
  // browser that might well have been running. We query the projects table
  // and keep the longest declared path that contains the cwd — the most
  // specific one wins, for nested projects.
  const cwd = process.cwd();
  try {
    const j = await http('GET', '/api/projects');
    const projects = (j.projects || j || []).filter((p) => p && p.cwd);
    let winner = null;
    for (const p of projects) {
      if (cwd !== p.cwd && !cwd.startsWith(p.cwd + '/')) continue;
      if (!winner || p.cwd.length > winner.cwd.length) winner = p;
    }
    if (winner) return winner.slug;
  } catch {
    // Orchestrator unreachable: fall back to the folder name, which stays
    // correct for most projects.
  }

  const m = /\/projects\/([A-Za-z0-9._-]+)(?:\/|$)/.exec(cwd);
  if (m) return m[1];
  process.stderr.write(
    'timon browser: could not find a project from cwd — pass the slug: timon browser status <slug>\n',
  );
  process.exit(64);
}

function printBrowser(session, slug, json) {
  if (json) {
    process.stdout.write(JSON.stringify(session ?? null, null, 2) + '\n');
    return;
  }
  if (!session || session.status !== 'running') {
    process.stdout.write(
      `browser ${slug}: STOPPED\n` +
      `  → start it with: timon browser start ${slug}\n` +
      '  (then restart your mission/task: the timon-browser MCP config is frozen at spawn)\n',
    );
    return;
  }
  const out = [`browser ${slug}: RUNNING`];
  out.push(`  CDP        : ${session.cdp_url}`);
  if (session.url) out.push(`  desktop    : ${session.url}`);
  out.push(`  container  : ${session.container_name}`);
  process.stdout.write(out.join('\n') + '\n');
}

async function cmdBrowserStatus(argv) {
  const json = argv.includes('--json');
  const slug = await browserSlug(argv);
  const j = await http('GET', `/api/browser/${encodeURIComponent(slug)}/status`);
  printBrowser(j.session, slug, json);
}

async function cmdBrowserStart(argv) {
  const json = argv.includes('--json');
  const slug = await browserSlug(argv);
  // First start pulls the Chromium image: can take several minutes.
  const j = await http('POST', `/api/browser/${encodeURIComponent(slug)}/start`, {});
  printBrowser(j.session, slug, json);
  if (!json && j.session && j.session.status === 'running') {
    process.stdout.write(
      '  ⚠ If your mission was ALREADY running before this start, the timon-browser\n' +
      '    tools are not wired yet: they appear at the next spawn of your mission.\n',
    );
  }
}

async function cmdBrowserStop(argv) {
  const json = argv.includes('--json');
  const slug = await browserSlug(argv);
  const j = await http('POST', `/api/browser/${encodeURIComponent(slug)}/stop`, {});
  if (json) process.stdout.write(JSON.stringify(j.session ?? null, null, 2) + '\n');
  else process.stdout.write(`browser ${slug}: stopped (profile kept)\n`);
}

async function cmdBrowserList(argv) {
  const j = await http('GET', '/api/browser');
  const sessions = j.sessions || [];
  if (argv.includes('--json')) {
    process.stdout.write(JSON.stringify(sessions, null, 2) + '\n');
    return;
  }
  if (!sessions.length) {
    process.stdout.write('no known browser\n');
    return;
  }
  for (const s of sessions) {
    process.stdout.write(
      `${s.status === 'running' ? '●' : '○'} ${s.project.padEnd(20)} ${s.status.padEnd(9)} ${s.cdp_url ?? ''}\n`,
    );
  }
}

/** `timon browser recording get <id>` — same route as the MCP tool `browser_recording_get`:
 *  the daemon answers only to the conversion mission the recording names. */
async function cmdBrowserRecording(argv) {
  const [sub, id] = argv;
  if (sub !== 'get' || !id) {
    process.stderr.write('usage: timon browser recording get <id>\n');
    process.exit(64);
  }
  const j = await http('GET', `/api/native-browser/recordings/${encodeURIComponent(id)}`);
  process.stdout.write(JSON.stringify(j, null, 2) + '\n');
}

/** `timon browser annotations get|resolve|dismiss` — same routes as the MCP tools
 *  `browser_annotations_get` / `browser_annotations_resolve`: the daemon answers a mission
 *  only for a batch the user sent it, and the profile owner on their session. */
async function cmdBrowserAnnotations(argv) {
  const [sub, ...rest] = argv;
  const usage = () => {
    process.stderr.write('usage: timon browser annotations get [<id>] [--batch <id>] [--status <s>] | resolve <id> --summary <text> | dismiss <id> --reason <text>\n');
    process.exit(64);
  };
  if (sub === 'get') {
    const json = takeSwitch(rest, 'json');
    const batch = takeFlag(rest, 'batch');
    const status = takeFlag(rest, 'status');
    const [id] = rest;
    let path = '/api/native-browser/annotations';
    if (id) path += `/${encodeURIComponent(id)}`;
    else {
      const query = new URLSearchParams();
      if (batch) query.set('batch', batch);
      if (status) query.set('status', status);
      if (query.toString()) path += `?${query}`;
    }
    const j = await http('GET', path);
    // Same reading as the MCP tool: the formatted block, unless the caller asks for the JSON.
    process.stdout.write(typeof j?.markdown === 'string' && !json ? j.markdown : JSON.stringify(j, null, 2) + '\n');
    return;
  }
  if (sub === 'resolve' || sub === 'dismiss') {
    const note = takeFlag(rest, sub === 'resolve' ? 'summary' : 'reason');
    const [id] = rest;
    if (!id || note === undefined) usage();
    const body = sub === 'resolve' ? { status: 'resolved', summary: note } : { status: 'dismissed', reason: note };
    const j = await http('POST', `/api/native-browser/annotations/${encodeURIComponent(id)}/resolve`, body);
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  usage();
}

async function cmdBrowser(argv) {
  const [sub, ...rest] = argv;
  switch (sub) {
    case undefined:
    case 'status': return cmdBrowserStatus(rest);
    case 'start':  return cmdBrowserStart(rest);
    case 'stop':   return cmdBrowserStop(rest);
    case 'list':   return cmdBrowserList(rest);
    case 'recording': return cmdBrowserRecording(rest);
    case 'annotations': return cmdBrowserAnnotations(rest);
    default:
      process.stderr.write('usage: timon browser status|start|stop|list [<slug>] [--json] | recording get <id> | annotations get|resolve|dismiss\n');
      process.exit(64);
  }
}

/** `timon health` — resource state of the machine as seen by Timon.
 *
 *  Exists because after the 08/13 freeze there was NO way to know, short of
 *  digging through /sys/fs/cgroup by hand, how much memory Timon was using
 *  or which profile (day/night) was in effect. We were flying blind. */
async function cmdHealth(argv) {
  const h = await http('GET', '/api/health/resources');
  if (argv.includes('--json')) {
    process.stdout.write(JSON.stringify(h, null, 2) + '\n');
    return;
  }
  const gb = (n) => (n === null || n === undefined ? '—' : `${(n / 1024 ** 3).toFixed(1)} GB`);
  const pct = (n) => (n === null || n === undefined ? 'unlimited' : `${n}% (${(n / 100).toFixed(1)} cores)`);
  const l = h.limits;
  const out = [];
  out.push(`profile      : ${h.profile}${h.appliedProfile && h.appliedProfile !== h.profile ? ` (applied: ${h.appliedProfile} ⚠)` : ''}`);
  out.push(`guard        : ${h.guardEnabled ? 'active' : 'DISABLED'}${h.systemd ? '' : ' (systemd absent)'}`);
  out.push(`missions     : ${h.liveMissions} live / ${l.maxLive} max — ${h.scopes.length} systemd scope(s)`);
  out.push(`load         : load1 ${h.loadavg[0].toFixed(2)} on ${h.cpuCount} cores`);
  if (h.daemon) {
    out.push(`heap         : ${h.daemon.heapUsedMb} MB used / ${h.daemon.heapLimitMb} MB limit — rss ${h.daemon.rssMb} MB`);
    out.push(`sse          : ${h.daemon.sse.clients} stream(s), ${h.daemon.sse.busEventListeners} bus listener(s)`);
  }
  out.push('');
  out.push(`missions slice (${h.missions.unit})`);
  out.push(`  memory     : ${gb(h.missions.memoryCurrent)} / high ${gb(h.missions.memoryHigh)} / max ${gb(h.missions.memoryMax)}`);
  out.push(`  CPU        : ${pct(h.missions.cpuQuotaPct)}, weight ${h.missions.cpuWeight ?? '—'}`);
  out.push(`  per mission: max ${l.missionMemMaxGb} GB, nice ${l.nice}, ionice class ${l.ioniceClass}`);
  if (h.missions.events) {
    out.push(`  events     : high ×${h.missions.events.high}, max ×${h.missions.events.max}, OOM kill ×${h.missions.events.oomKill}`);
  }
  out.push('');
  out.push(`orchestrator (${h.service.unit})`);
  out.push(`  memory     : ${gb(h.service.memoryCurrent)} / high ${gb(h.service.memoryHigh)} / max ${gb(h.service.memoryMax)}`);
  out.push(`  CPU        : ${pct(h.service.cpuQuotaPct)}, weight ${h.service.cpuWeight ?? '—'}`);
  if (h.service.events) {
    out.push(`  events     : high ×${h.service.events.high}, max ×${h.service.events.max}, OOM kill ×${h.service.events.oomKill}`);
  }
  if (h.scopes.length) {
    out.push('');
    out.push('live scopes:');
    for (const s of h.scopes) out.push(`  ${s}`);
  }
  process.stdout.write(out.join('\n') + '\n');
}

/** Path of the compiled module, resolved from this file (bin/ sits next to dist/). */
async function loadDist(mod) {
  const url = new URL(`../dist/${mod}.js`, import.meta.url);
  try {
    return await import(url.href);
  } catch (e) {
    // Only when that very file is missing: a refusal raised while the module loads (db.ts) speaks for itself.
    if (e?.code === 'ERR_MODULE_NOT_FOUND' && String(e.message).includes(fileURLToPath(url))) {
      process.stderr.write(
        `timon: dist/${mod}.js not found — run \`npm run build\` in orchestrator/.\n`,
      );
    }
    throw e;
  }
}

/** `timon export` — portable archive of the install, secrets excluded.
 *  Goes through the daemon when it's running (its connection sees the
 *  current WAL), otherwise VACUUMs the file itself. */
async function cmdExport(argv) {
  const args = argv.slice();
  const out = takeFlag(args, 'out');
  const withArchive = args.includes('--with-archive');
  const json = args.includes('--json');

  let result = null;
  // Daemon absent = normal case (moving, fresh machine): fall back to the
  // local export rather than failing.
  let viaDaemon = null;
  try {
    viaDaemon = await httpRaw('POST', '/api/admin/export', { out, withArchive });
  } catch { /* daemon unreachable */ }
  if (viaDaemon && viaDaemon.ok && viaDaemon.body && viaDaemon.body.ok) {
    result = viaDaemon.body;
  } else {
    const { exportTimon } = await loadDist('export');
    const dest = out || `timon-export-${new Date().toISOString().slice(0, 10)}.tar.gz`;
    result = exportTimon({ out: dest, withArchive });
  }

  if (json) {
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
    return;
  }
  const mb = (result.bytes / 1024 ** 2).toFixed(1);
  process.stdout.write(
    `archive: ${result.out} (${mb} MB)\n`
    + `paths rewritten to ~: ${result.rewritten}\n`
    + `events archive included: ${result.manifest.withArchive ? 'yes' : 'no'}\n`
    + `secrets: never included (secrets.env, remote-key, daemon-token)\n`,
  );
}

/** `timon import F` — restores an archive. Always local: the target
 *  machine's daemon isn't necessarily running (that's even the normal case). */
async function cmdImport(argv) {
  const args = argv.slice();
  const to = takeFlag(args, 'to');
  const force = args.includes('--force');
  const skipProjects = args.includes('--no-projects');
  const json = args.includes('--json');
  const file = args.find((a) => !a.startsWith('--'));
  if (!file) {
    process.stderr.write('usage: timon import <archive.tar.gz> [--to DIR] [--force] [--no-projects]\n');
    process.exit(64);
  }
  const { importTimon } = await loadDist('export');
  const result = importTimon({ file, to, force, skipProjects });
  if (json) {
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
    return;
  }
  process.stdout.write(
    `restored to ${result.to} (${result.restored} entries, archive from `
    + `${new Date(result.manifest.exportedAt).toISOString().slice(0, 10)} `
    + `from ${result.manifest.hostname})\n`
    + (skipProjects ? `projects skipped: ${result.skippedProjects}\n` : '')
    + (result.missingProjects.length
      ? `\nProjects whose folder was not found on this machine (${result.missingProjects.length}):\n`
        + result.missingProjects.map((p) => `  - ${p.slug}: ${p.cwd}`).join('\n')
        + '\n  Re-import with --no-projects to leave them out, or fix their folder from the Projects page.\n'
      : '')
    + `\nTo redo by hand:\n`
    + result.todo.map((t) => `  - ${t}`).join('\n') + '\n',
  );
}

/**
 * `timon docs search|read` — the MCP tools `docs_search` / `docs_read`: the
 * documentation of the INSTALLED version, read locally. No daemon, no network.
 */
async function cmdDocs(argv) {
  const args = argv.slice();
  const [sub] = args.splice(0, 1);
  const json = args.includes('--json');
  const words = args.filter((a) => a !== '--json');
  if (sub !== 'search' && sub !== 'read') {
    process.stderr.write(
      'usage: timon docs search <words...> [--limit N] [--json]\n'
      + '       timon docs read [<route>] [--heading TEXT]\n',
    );
    process.exit(64);
  }
  const { loadDocs, searchDocs, readDoc, docsIndex } = await import('./docs-local.mjs');
  const docs = await loadDocs();
  if (!docs) {
    throw new Error('The Timon documentation is not bundled with this install. Read it online: https://docs.timon-ai.com/llms.txt');
  }
  if (sub === 'search') {
    const limit = takeFlag(words, 'limit');
    const query = words.join(' ').trim();
    if (!query) {
      process.stderr.write(
        'usage: timon docs search <words...> [--limit N] [--json]\n'
        + '       timon docs read [<route>] [--heading TEXT]\n',
      );
      process.exit(64);
    }
    const hits = searchDocs(docs.pages, query, limit);
    if (json) {
      process.stdout.write(JSON.stringify(hits, null, 2) + '\n');
      return;
    }
    if (!hits.length) {
      process.stdout.write('No page matches.\n');
      return;
    }
    for (const h of hits) process.stdout.write(`${h.route} — ${h.title}\n  ${h.excerpt}\n`);
    return;
  }
  const heading = takeFlag(words, 'heading');
  process.stdout.write(words[0] ? readDoc(docs.pages, words[0], heading) : docsIndex(docs.pages));
}

function formatTs(ms) {
  if (typeof ms !== 'number' || !Number.isFinite(ms)) return '—';
  return new Date(ms).toISOString();
}

function printBackupStatus(s) {
  const on = s.enabled ? 'enabled' : 'disabled';
  process.stdout.write(
    `nightly backup: ${on}\n`
    + `cron     ${s.cron || '30 3 * * *'}\n`
    + `keep     ${s.keep ?? 7} archives${s.max_age_days > 0 ? `, at most ${s.max_age_days} days old` : ''}\n`
    + `dir      ${s.dir}\n`
    + `last     ${formatTs(s.last_run_at)}\n`
    + `next     ${formatTs(s.next_run_at)}\n`,
  );
  const archives = Array.isArray(s.archives) ? s.archives : [];
  if (!archives.length) {
    process.stdout.write('archives (0)\n');
    return;
  }
  process.stdout.write(`archives (${archives.length})\n`);
  for (const a of archives) {
    const mb = ((a.bytes || 0) / 1024 ** 2).toFixed(1);
    process.stdout.write(`  ${a.name}  ${mb} MB\n`);
  }
}

/**
 * `timon widgets get|propose|preset-save` — the user's widget arrangement, as
 * the MCP tools of the same names reach it. Whose arrangement: the account
 * behind the token (an agent's mission owner), never an argument. `propose`
 * raises a card the user applies; only a preset is written directly.
 */
async function cmdWidgets(argv) {
  const [sub, ...rest] = argv;
  const view = takeFlag(rest, 'view');
  const project = takeFlag(rest, 'project');
  const target = {};
  if (view !== undefined) target.view = view;
  if (project !== undefined) target.project = project;
  if (sub === 'get') {
    const qs = new URLSearchParams(target).toString();
    const j = await http('GET', `/api/widgets${qs ? `?${qs}` : ''}`);
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  if (sub === 'propose') {
    const note = takeFlag(rest, 'note');
    const raw = await readContent(rest, 'proposal JSON ({zones?, remove?, columns?})');
    let parsed;
    try {
      parsed = JSON.parse(raw);
    } catch (e) {
      process.stderr.write('timon: invalid JSON — ' + e.message + '\n');
      process.exit(64);
    }
    const body = { ...parsed, ...target, ...(note !== undefined ? { note } : {}) };
    const j = await http('POST', '/api/widgets/proposals', body);
    process.stdout.write(JSON.stringify({ id: j.id, status: j.status, message: j.message }, null, 2) + '\n');
    return;
  }
  if (sub === 'preset-save') {
    const replace = rest.includes('--replace');
    const name = rest.filter((a) => a !== '--replace').join(' ').trim();
    if (!name) {
      process.stderr.write('usage: timon widgets preset-save <name> [--view PATH] [--project SLUG] [--replace]\n');
      process.exit(64);
    }
    const j = await http('POST', '/api/widgets/presets', { name, ...target, ...(replace ? { replace: true } : {}) });
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  process.stderr.write('usage: timon widgets <get|propose|preset-save> [--view PATH] [--project SLUG]\n');
  process.exit(64);
}

/**
 * `timon islands get|propose|preset-save|arrangements|arrangement-save` — the
 * user's island workspace, as the MCP tools of the same names reach it. Whose workspace: the account
 * behind the token (an agent's mission owner), never an argument. `propose`
 * raises a card the user applies; only a preset is written directly, and it
 * is the view's preset (`/api/widgets/presets` captures `.islands` too).
 */
async function cmdIslands(argv) {
  const [sub, ...rest] = argv;
  const view = takeFlag(rest, 'view');
  const project = takeFlag(rest, 'project');
  const target = {};
  if (view !== undefined) target.view = view;
  if (project !== undefined) target.project = project;
  if (sub === 'get') {
    const qs = new URLSearchParams(target).toString();
    const j = await http('GET', `/api/islands${qs ? `?${qs}` : ''}`);
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  if (sub === 'propose') {
    const note = takeFlag(rest, 'note');
    const arrangement = takeFlag(rest, 'arrangement');
    let parsed;
    if (arrangement !== undefined) {
      // A named arrangement is the whole workspace: nothing to read besides its id.
      parsed = { arrangement };
    } else {
      const raw = await readContent(rest, 'proposal JSON ({open: {content, edge, island?}} or {layout: {root, focus?}})');
      try {
        parsed = JSON.parse(raw);
      } catch (e) {
        process.stderr.write('timon: invalid JSON — ' + e.message + '\n');
        process.exit(64);
      }
    }
    const body = { ...parsed, ...target, ...(note !== undefined ? { note } : {}) };
    const j = await http('POST', '/api/islands/proposals', body);
    process.stdout.write(JSON.stringify({ id: j.id, status: j.status, message: j.message, ...(j.warnings ? { warnings: j.warnings } : {}) }, null, 2) + '\n');
    return;
  }
  if (sub === 'preset-save') {
    const replace = rest.includes('--replace');
    const name = rest.filter((a) => a !== '--replace').join(' ').trim();
    if (!name) {
      process.stderr.write('usage: timon islands preset-save <name> [--view PATH] [--project SLUG] [--replace]\n');
      process.exit(64);
    }
    const j = await http('POST', '/api/widgets/presets', { name, ...target, ...(replace ? { replace: true } : {}) });
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  if (sub === 'arrangements') {
    const j = await http('GET', `/api/islands/arrangements${rest.includes('--full') ? '?full=1' : ''}`);
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  if (sub === 'arrangement-save') {
    const file = takeFlag(rest, 'file');
    const replace = rest.includes('--replace');
    const name = rest.filter((a) => a !== '--replace').join(' ').trim();
    if (!name) {
      process.stderr.write('usage: timon islands arrangement-save <name> [--view PATH] [--project SLUG] [--file LAYOUT.json] [--replace]\n');
      process.exit(64);
    }
    let layout;
    if (file) {
      try {
        layout = JSON.parse(fs.readFileSync(file, 'utf8'));
      } catch (e) {
        process.stderr.write('timon: invalid layout file — ' + e.message + '\n');
        process.exit(64);
      }
    }
    const body = { name, ...target, ...(layout !== undefined ? { layout } : {}), ...(replace ? { replace: true } : {}) };
    const j = await http('POST', '/api/islands/arrangements', body);
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  process.stderr.write('usage: timon islands <get|propose|preset-save|arrangements|arrangement-save> [--view PATH] [--project SLUG]\n');
  process.exit(64);
}

/**
 * `timon navigate routes|go` — the MCP tools `ui_routes` / `ui_navigate`.
 * `go` raises a card the user follows; nothing changes on screen by itself.
 */
async function cmdNavigate(argv) {
  const [sub, ...rest] = argv;
  if (sub === 'routes') {
    process.stdout.write(JSON.stringify(await http('GET', '/api/navigate/routes'), null, 2) + '\n');
    return;
  }
  if (sub === 'go') {
    const note = takeFlag(rest, 'note');
    const params = {};
    for (let v = takeFlag(rest, 'param'); v !== undefined; v = takeFlag(rest, 'param')) {
      const eq = v.indexOf('=');
      if (eq < 1) {
        process.stderr.write('usage: --param key=value\n');
        process.exit(64);
      }
      params[v.slice(0, eq)] = v.slice(eq + 1);
    }
    const path = rest[0];
    if (!path) {
      process.stderr.write('usage: timon navigate go <path> [--param k=v]... [--note TEXT]\n');
      process.exit(64);
    }
    const body = { path, ...(Object.keys(params).length ? { params } : {}), ...(note !== undefined ? { note } : {}) };
    const j = await http('POST', '/api/navigate/proposals', body);
    process.stdout.write(JSON.stringify({ id: j.id, status: j.status, message: j.message, ...(j.warnings ? { warnings: j.warnings } : {}) }, null, 2) + '\n');
    return;
  }
  process.stderr.write('usage: timon navigate <routes|go>\n');
  process.exit(64);
}

/**
 * `timon setup avatar|soul|team|finish` — the MCP tools `setup_*`: the main agent
 * builds itself in its own setup conversation. Refused anywhere else.
 */
async function cmdNav(argv) {
  const [sub, ...rest] = argv;
  if (sub === 'get') {
    process.stdout.write(JSON.stringify(await http('GET', '/api/nav'), null, 2) + '\n');
    return;
  }
  if (sub === 'propose') {
    const note = takeFlag(rest, 'note');
    const list = (v) => (v === undefined ? undefined : v.split(',').map((p) => p.trim()).filter(Boolean));
    const order = list(takeFlag(rest, 'order'));
    const footer = list(takeFlag(rest, 'footer'));
    const hidden = [];
    for (let v = takeFlag(rest, 'hide'); v !== undefined; v = takeFlag(rest, 'hide')) hidden.push(v);
    // No flag at all still means "show every page again", as before the layout existed.
    const body = {
      ...(hidden.length || (order === undefined && footer === undefined) ? { hidden } : {}),
      ...(order !== undefined ? { order } : {}),
      ...(footer !== undefined ? { footer } : {}),
      ...(note !== undefined ? { note } : {}),
    };
    const j = await http('POST', '/api/nav/proposals', body);
    process.stdout.write(JSON.stringify({ id: j.id, status: j.status, message: j.message, ...(j.warnings ? { warnings: j.warnings } : {}) }, null, 2) + '\n');
    return;
  }
  process.stderr.write('usage: timon nav <get|propose>\n');
  process.exit(64);
}

/** `timon ui-doc render` — the daemon reads the file under the mission's directory, like `ui_render { path }`. */
async function cmdUiDoc(argv) {
  const [sub, ...rest] = argv;
  if (sub === 'render') {
    const title = takeFlag(rest, 'title');
    const reply = rest.includes('--reply');
    const file = rest.filter((a) => a !== '--reply')[0];
    if (file) {
      const path = resolvePath(process.cwd(), file);
      const body = { title: title ?? path.split(/[\\/]/).pop(), path, ...(reply ? { reply: true } : {}) };
      const j = await http('POST', '/api/ui-documents', body);
      process.stdout.write(JSON.stringify({
        id: j.id, status: j.status, ...(j.reply !== undefined ? { reply: j.reply } : {}), ...(j.message ? { message: j.message } : {}),
      }, null, 2) + '\n');
      return;
    }
  }
  if (sub === 'get' && rest[0]) {
    const j = await http('GET', `/api/ui-documents/${encodeURIComponent(rest[0])}`);
    process.stdout.write(JSON.stringify(j.document, null, 2) + '\n');
    return;
  }
  process.stderr.write('usage: timon ui-doc render <file.html> [--title TEXT] [--reply] | timon ui-doc get <id>\n');
  process.exit(64);
}

async function cmdOnboarding(argv) {
  const [sub, verb, value] = argv;
  if (sub === 'profile' && verb === undefined) {
    process.stdout.write(JSON.stringify(await http('GET', '/api/onboarding/profile'), null, 2) + '\n');
    return;
  }
  if (sub === 'profile' && verb === 'set' && value) {
    process.stdout.write(JSON.stringify(await http('PUT', '/api/onboarding/profile', { profile: value }), null, 2) + '\n');
    return;
  }
  process.stderr.write('usage: timon onboarding profile [set <developer|automation|beginner>]\n');
  process.exit(64);
}

async function cmdSetup(argv) {
  const [sub, ...rest] = argv;
  if (sub === 'avatar') {
    const j = await http('POST', '/api/setup/agent/avatar-request', {});
    process.stdout.write(JSON.stringify(j, null, 2) + '\n');
    return;
  }
  if (sub === 'soul') {
    const objective = takeFlag(rest, 'objective');
    const soul = await readContent(rest, 'the soul (markdown)');
    const body = { soul, ...(objective !== undefined ? { objective } : {}) };
    process.stdout.write(JSON.stringify(await http('POST', '/api/setup/agent/soul', body), null, 2) + '\n');
    return;
  }
  if (sub === 'team') {
    const coder = takeFlag(rest, 'coder');
    const reviewer = takeFlag(rest, 'reviewer');
    if (coder && reviewer) {
      process.stdout.write(JSON.stringify(await http('POST', '/api/setup/agent/team', { coder, reviewer }), null, 2) + '\n');
      return;
    }
  }
  if (sub === 'finish') {
    const body = rest.includes('--no-tour') ? { tour: false } : {};
    process.stdout.write(JSON.stringify(await http('POST', '/api/setup/agent/finish', body), null, 2) + '\n');
    return;
  }
  process.stderr.write('usage: timon setup <avatar|soul|team --coder NAME --reviewer NAME|finish [--no-tour]>\n');
  process.exit(64);
}

/** `timon backup enable|status` — the routine lives in the daemon (03:30 tick). */
async function cmdBackup(argv) {
  const [sub, ...rest] = argv;
  const json = rest.includes('--json') || argv.includes('--json');
  if (sub === 'enable') {
    const j = await http('POST', '/api/backup/enable', {});
    if (json) {
      process.stdout.write(JSON.stringify(j, null, 2) + '\n');
      return;
    }
    printBackupStatus(j);
    return;
  }
  if (sub === 'status') {
    const j = await http('GET', '/api/backup/status');
    if (json) {
      process.stdout.write(JSON.stringify(j, null, 2) + '\n');
      return;
    }
    printBackupStatus(j);
    return;
  }
  process.stderr.write('usage: timon backup <enable|status> [--json]\n');
  process.exit(64);
}

/**
 * `timon app status|restart` — the Next app served by the daemon as a child.
 *
 * Neither of these two commands touches systemd: `systemctl restart
 * timon-orchestrator` would indeed relaunch the app, but would also kill
 * ALL live missions, including the one of the agent who typed the command.
 * We go through the pidfile published by the supervisor (`~/.timon/run/web-app.pid`).
 */
async function cmdApp(argv) {
  const [sub, ...rest] = argv;
  const json = argv.includes('--json');
  const mod = await loadDist('plugins-bundled/web-app/control');

  switch (sub) {
    case 'status':
    case undefined: {
      const st = mod.appStatus();
      if (json) {
        process.stdout.write(JSON.stringify(st, null, 2) + '\n');
        return;
      }
      process.stdout.write(`${st.state} — ${st.message}\n`);
      // A "not running" state is not an error: `app.enabled` defaults to
      // `false`, and an `exit 1` would break scripts calling
      // `timon app status` just to check where things stand.
      return;
    }

    case 'restart': {
      let r = mod.restartApp();
      // No live child: the supervisor is between two attempts or gave up.
      // Signalling is impossible, so ask the daemon to wake it (TODO #485).
      if (!r.ok && mod.appStatus().state === 'stopped') r = await rearmApp(r);
      if (json) {
        process.stdout.write(JSON.stringify(r, null, 2) + '\n');
      } else {
        process.stdout.write(r.message + '\n');
      }
      if (!r.ok) process.exitCode = 1;
      return;
    }

    default:
      process.stderr.write(`timon app: unknown subcommand "${sub}" (status|restart)\n`);
      process.exit(64);
  }
}

/**
 * `POST /api/app/rearm` — daemon token only: from a mission (mission token) or
 * against another daemon's profile, the daemon refuses it and we say why.
 * Unreachable daemon: the local status message stays the answer.
 */
async function rearmApp(fallback) {
  let res;
  try {
    res = await httpRaw('POST', '/api/app/rearm');
  } catch {
    return fallback;
  }
  const message = typeof res.body?.message === 'string' ? res.body.message : `rearm refused (${res.status})`;
  if (res.status === 401 || res.status === 403) {
    return { ok: false, pid: null, message: `${fallback.message}\nRearming the web app needs the daemon token: run \`timon app restart\` from a terminal on the daemon host, not from a mission.` };
  }
  return { ok: res.ok, pid: null, message };
}

/**
 * `timon service install|uninstall|stop|start|status|repair` — the daemon's supervisor (5.3).
 *
 * Always LOCAL: a service belongs to the machine you're typing on, never to
 * the daemon a `--daemon` profile points at. Installing a unit on the wrong
 * host would leave a second daemon fighting for the same TIMON_HOME.
 */
async function cmdService(argv) {
  const [sub, ...rest] = argv;
  const json = argv.includes('--json');
  const dryRun = argv.includes('--dry-run');
  const mod = await loadDist('host/service-install');
  const { FORCE_FLAG, foreignService, guardServiceGesture, ownerLines, servicesSharingHome } = await loadDist('host/service-ownership');
  const { config } = await loadDist('config/load');
  const { createHost } = await loadDist('host/index');
  const { markPackagedCli, serviceOptsFromEnvironment } = await loadDist('host/service-environment');
  const { timonVersion } = await loadDist('data-version');
  const { TIMON_HOME } = await loadDist('paths');

  // The options of the onboarding button: run from the packaged app, the
  // service needs its Electron environment, its first-launch ports and its
  // staged runtime. Before `config()`, which reads those ports.
  markPackagedCli(process.env, process.versions, timonVersion(), TIMON_HOME);
  const cfg = config();
  const host = createHost(cfg);
  const opts = {
    ...serviceOptsFromEnvironment(cfg, () => host),
    // No timeout, unlike the button: `sudo` may be waiting for a password.
    // A binary the host can't find must fail the command, not throw a stack.
    exec: (name, args) => {
      try {
        return host.exec(name, args);
      } catch (e) {
        return { code: 127, stdout: '', stderr: e.message };
      }
    },
    dryRun,
  };

  // The service name is shared: before anything else, is it this installation's? (TODO #734)
  const guard = ['install', 'uninstall', 'stop', 'start'].includes(sub)
    ? guardServiceGesture(opts, sub, { force: argv.includes(FORCE_FLAG), sourceInstallDir: cfg.daemon.installDir })
    : { refusal: null, replacing: null, notice: null };
  if (guard.replacing) opts.replacing = guard.replacing;

  let res = guard.refusal;
  if (!res) switch (sub) {
    case 'install': {
      // A home under the OS temporary folder is a test's: its service would
      // outlive the test and restart forever once the folder is emptied (#464).
      const { ALLOW_TEMPORARY_HOME_FLAG, temporaryHomeNotice } = await loadDist('host/temporary-home');
      // A dry run writes nothing: it only gets the warning.
      const temporary = temporaryHomeNotice(opts.timonHome, dryRun || argv.includes(ALLOW_TEMPORARY_HOME_FLAG));
      if (temporary?.refuse) {
        res = { ok: false, code: 1, lines: temporary.lines, reason: 'temporary home' };
        break;
      }
      if (temporary) process.stderr.write(temporary.lines.join('\n') + '\n');
      // Before staging, writing or any administrator prompt (TIM-0045/0046).
      res = mod.installPreflight(opts);
      if (res) break;
      if (dryRun) {
        res = mod.installService(opts);
      } else if (!guard.replacing && await replacesRunningRelease(opts, timonVersion(), TIMON_HOME)) {
        // A plain install would mark this release active while the previous
        // daemon keeps running: the desktop then never moves it either.
        const applied = await applyPackagedUpdate({ allowOlder: true });
        res = { ok: applied.code === 0, code: applied.code, lines: applied.lines };
      } else {
        const { installWithRuntime } = await loadDist('host/packaged-install');
        try {
          res = await installWithRuntime(opts, cfg.daemon.installDir, mod.installService);
        } catch (e) {
          res = { ok: false, code: 1, lines: [`service install failed: ${e.message}`] };
        }
      }
      break;
    }
    case 'uninstall': {
      const { uninstallWithRuntime } = await loadDist('host/packaged-install');
      res = await uninstallWithRuntime(opts, mod.uninstallService);
      break;
    }
    case 'stop': {
      res = mod.stopService(opts);
      if (res.ok && !dryRun) {
        const { endMissionsOfStoppedDaemon } = await loadDist('host/mission-processes');
        const ended = await endMissionsOfStoppedDaemon(opts.timonHome, host);
        if (ended) res = { ...res, lines: [...res.lines, ended] };
      }
      break;
    }
    case 'start':
      res = mod.startService(opts);
      break;
    case 'repair':
      res = mod.repairSessionWitness(opts);
      break;
    case 'status':
    case undefined:
      res = mod.statusService(opts);
      // schtasks says "Running" for a launcher that is only waiting; the notes say why.
      if (res.installed) res = { ...res, lines: [...res.lines, ...mod.windowsServiceNotes(opts)] };
      {
        const foreign = foreignService(opts, cfg.daemon.installDir);
        if (foreign) {
          const proven = foreign.why === 'home' || foreign.why === 'install';
          res = { ...res, lines: [...res.lines, `owner     : ${proven ? 'another Timon installation, not this one' : 'not proven to be this installation'}`, ...ownerLines(foreign)] };
        }
        for (const shared of servicesSharingHome(opts)) {
          const also = shared.why === 'shared' ? 'another service on this data directory' : 'another service that could not be checked, it may run on this data directory';
          res = { ...res, lines: [...res.lines, `also      : ${also}`, ...ownerLines(shared)] };
        }
      }
      break;
    default:
      process.stderr.write(`timon service: unknown subcommand "${sub}" (install|uninstall|stop|start|status|repair)\n`);
      process.exit(64);
  }

  if (guard.notice) res = { ...res, lines: [guard.notice, ...res.lines] };
  if (json) {
    process.stdout.write(JSON.stringify(res, null, 2) + '\n');
  } else {
    process.stdout.write(res.lines.join('\n') + '\n');
  }
  if (res.code !== 0) process.exitCode = res.code;
}

/**
 * A packaged service already installed here, on another release than this
 * package, or whose daemon reports another version (an install from an
 * earlier CLI marked this release without restarting the daemon).
 */
async function replacesRunningRelease(opts, cliVersion, home) {
  const { stagesPackagedRuntime } = await loadDist('host/service-environment');
  if (!stagesPackagedRuntime(opts.platform, process.env)) return false;
  const { readServiceDefinition } = await loadDist('host/service-install');
  if (readServiceDefinition(opts) === null) return false;
  const { packagedReleaseId, readActiveRelease } = await loadDist('host/packaged-service');
  if (await readActiveRelease(home) !== packagedReleaseId(cliVersion)) return true;
  const daemonVersion = await runningDaemonVersion();
  return daemonVersion !== null && daemonVersion !== cliVersion;
}

/**
 * `timon module …` — enabling BUNDLED modules, in `timon.config.json`.
 *
 * Not to be confused with `timon plugin`, which governs THIRD-PARTY plugins
 * and takes effect hot. Bundled modules are mounted at boot: toggling them
 * only takes effect on the daemon's next start, which we remind on every
 * write and which the CLI never triggers itself.
 */
async function cmdModule(argv) {
  const [sub, ...rest] = argv;
  const json = argv.includes('--json');
  const mod = await loadDist('kernel/module-config');

  switch (sub) {
    case 'list':
    case undefined: {
      const rows = mod.listModules();
      if (json) {
        process.stdout.write(JSON.stringify(rows, null, 2) + '\n');
        return;
      }
      const width = Math.max(...rows.map((r) => r.id.length));
      for (const r of rows) {
        const state = r.active ? 'active' : 'inactive';
        const wanted = r.wanted === 'auto' ? 'auto' : (r.wanted ? 'forced' : 'off');
        process.stdout.write(
          `${r.id.padEnd(width)}  ${r.tier.padEnd(4)}  ${state.padEnd(7)}  ${wanted}`
          + (r.reason ? `  — ${r.reason}` : '') + '\n',
        );
      }
      return;
    }

    case 'enable':
    case 'disable': {
      const asked = rest.find((a) => !a.startsWith('--'));
      if (!asked) {
        process.stderr.write(`usage: timon module ${sub} <name>\n`);
        process.exit(64);
      }
      // A legacy id (`grepai`) is still accepted; what we report — and what is
      // written — is the current one (`@timon/grepai`).
      const { canonicalModuleId } = await loadDist('kernel/legacy-ids');
      const id = canonicalModuleId(asked);
      mod.setModuleEnabled(asked, sub === 'enable');
      process.stdout.write(
        `${id} ${sub === 'enable' ? 'enabled' : 'disabled'} in timon.config.json\n`
        + 'bundled modules are mounted at boot: effective on next daemon start\n',
      );
      // `web-app` has TWO switches: the module (here) and `app.enabled`,
      // which decides whether the app launches. Enabling one without the
      // other does nothing, and staying silent would suggest it worked.
      if (id === '@timon/web-app' && sub === 'enable') {
        process.stdout.write('reminder: the app only starts if `app.enabled` is true (see docs/REBUILD.md)\n');
      }
      return;
    }

    default:
      process.stderr.write(`timon module: unknown subcommand "${sub}" (list|enable|disable)\n`);
      process.exit(64);
  }
}

/**
 * `timon plugin …` — always local, and that's the important part.
 *
 * These commands only write two files: the npm tree of
 * `~/.timon/plugins/` and `~/.timon/timon.config.json`. The daemon watches
 * them and rebuilds its plugin tree on its own — routes mounted or removed,
 * effects undone — WITHOUT a restart. The CLI therefore doesn't need to
 * reach it, or even for it to be running: it sets the wanted state, the
 * daemon follows once it's there.
 */
/**
 * The Node the daemon runs plugins on (TODO #763). The CLI runs on another
 * one — the system Node, while a packaged daemon runs on the runtime it ships
 * — so `engines.node` is read against the daemon's answer. A daemon that does
 * not answer leaves this process's Node, flagged `local` so the message says
 * it is an estimate.
 */
async function daemonNodeRuntime() {
  try {
    const r = await httpRaw('GET', '/api/admin/system', undefined, 3000);
    const info = r.ok && r.body && typeof r.body === 'object' ? r.body : null;
    const node = info?.runtime?.node;
    if (typeof node === 'string' && node) {
      return {
        node,
        electron: typeof info.runtime.electron === 'string' ? info.runtime.electron : null,
        packaged: info.daemon?.packagedRuntime === true,
        source: 'daemon',
      };
    }
  } catch { /* daemon down, or no route: fall back below */ }
  const { currentNodeRuntime } = await loadDist('plugins/node-engine');
  return currentNodeRuntime('local');
}

async function cmdPlugin(argv) {
  const [sub, ...rest] = argv;
  const json = rest.includes('--json') || argv.includes('--json');
  // Before the install module: a check reads a folder, nothing of ~/.timon/plugins.
  if (sub === 'check') return cmdPluginCheck(rest);
  const mod = await loadDist('plugins/install');

  switch (sub) {
    case 'list':
    case undefined: {
      // engines.node is read against the daemon's Node, as its loader does.
      const items = mod.inventory(undefined, undefined, undefined, await daemonNodeRuntime());
      if (json) {
        process.stdout.write(JSON.stringify(items, null, 2) + '\n');
        return;
      }
      if (!items.length) {
        process.stdout.write('no plugin installed (timon plugin add <spec>)\n');
        return;
      }
      for (const p of items) {
        const state = p.refused ? p.refused : (p.enabled ? 'active' : 'disabled');
        process.stdout.write(`${p.id}  ${p.version}  ${state}  [${p.builtin ? 'built-in' : p.pkg}]\n`);
        if (p.message) process.stdout.write(`    ${p.message}\n`);
      }
      return;
    }

    case 'add': {
      const spec = rest.find((a) => !a.startsWith('--'));
      if (!spec) {
        process.stderr.write('usage: timon plugin add <spec> [--yes]\n');
        process.exit(64);
      }
      // npm cannot install a .zip: it is extracted into the plugins folder
      // first, as the gallery does, then goes through the same addPlugin.
      let result;
      let zipFolder = null;
      // Refused when its engines.node excludes the DAEMON's Node, not this CLI's.
      const runtime = await daemonNodeRuntime();
      if (/\.zip$/i.test(spec)) {
        const { PluginInstallSources, PluginSourceError } = await loadDist('plugins/install-sources');
        try {
          ({ result, folder: zipFolder } = await new PluginInstallSources({ install: { runtime } }).addZipFile(resolvePath(spec)));
        } catch (err) {
          if (!(err instanceof PluginSourceError) && !(err instanceof mod.PluginEngineError)) throw err;
          process.stderr.write(`cannot install ${spec}: ${err.message}\n`);
          process.exit(1);
        }
      } else {
        try {
          result = await mod.addPlugin(spec, undefined, { runtime });
        } catch (err) {
          if (!(err instanceof mod.PluginEngineError)) throw err;
          process.stderr.write(`cannot install ${spec}: ${err.message}\n`);
          process.exit(1);
        }
      }
      // No daemon answered: the CLI's Node is only an estimate, said, not enforced.
      if (result.engineWarning) {
        process.stderr.write(`warning: ${result.engineWarning}\nThe daemon checks it again when it loads the plugin.\n`);
      }
      if (result.refused) {
        // The package IS installed: refusing it silently would leave the
        // user with a plugin that "does nothing" for no visible reason.
        process.stderr.write(`${result.pkg} installed but NOT loaded (${result.refused})\n${result.message}\n`);
        process.exit(1);
      }
      // Confirmation comes AFTER installation because the requested
      // permissions live in the manifest, i.e. inside the package: we
      // can't show them before having it. Nothing of the package has RUN by
      // then: `--ignore-scripts` keeps npm from executing its lifecycle
      // scripts, and only the daemon ever imports its host half. Decline ⇒
      // we uninstall.
      const perms = result.manifest.permissions;
      // Permissions that change work, not just read it, are named apart. A daemon
      // build that predates the list simply shows none.
      const { SENSITIVE_PLUGIN_PERMISSIONS: sensitiveList = [], dictationEgressLines = () => [] } = await loadDist('plugins/manifest');
      const sensitive = perms.filter((p) => sensitiveList.includes(p));
      // A dictation engine hears the user: where the voice goes is said before the yes.
      const voice = dictationEgressLines(result.manifest);
      // The signed release of an unsigned copy keeps what that copy held (`keepsPluginData`).
      const update = result.updatesUnsigned ? 'update from an unsigned copy: data and settings kept\n' : '';
      // Asked even with zero permissions, and that is the point (secu-5): the
      // permissions govern the FACADE, not the process. A loaded plugin runs
      // in the daemon's own Node process, so activating one is running its
      // code as you — permissions or not (SECURITY.md §9).
      if (!rest.includes('--yes')) {
        const admission = result.signature.ok
          ? `signature: valid (${result.signature.keyId})`
          : `signature: ${result.signature.code.toUpperCase()} — ${result.signature.message}`;
        const ok = await confirm(
          `${result.id}@${result.version}\n`
          + `requests: ${perms.length ? perms.join(', ') : 'no facade permission'}\n`
          + (sensitive.length ? `SENSITIVE: ${sensitive.join(', ')} (act on your projects and agents, on missions, triggers or pipelines, validate requests, reach secrets, accounts, plugins or the machine itself, not just read your work)
` : '')
          + (voice.length ? `VOICE: ${voice.join('; ')}\n` : '')
          + `${admission}\n`
          + update
          + 'This plugin runs IN the daemon process, with your account\'s rights:\n'
          + 'it can reach anything you can, permissions notwithstanding.\n'
          + 'Install and activate? [y/N] ',
        );
        if (!ok) {
          await mod.removePlugin(result.pkg);
          // The folder extracted from the zip is ours: it would linger as "available".
          if (zipFolder) fs.rmSync(zipFolder, { recursive: true, force: true });
          process.stdout.write('cancelled, package uninstalled\n');
          return;
        }
      }
      if (json) {
        process.stdout.write(JSON.stringify(result, null, 2) + '\n');
        return;
      }
      // Held back by the licence whatever its signature: said instead of
      // "loads within the second". The guard covers a `dist/` built before
      // the lock, which the repository's CLI can run until the next rebuild.
      if (typeof mod.heldForWhiteLabel === 'function' && mod.heldForWhiteLabel(result.manifest)) {
        process.stdout.write(
          `${result.id}@${result.version} installed (${result.pkg})\n`
          + `permissions: ${perms.length ? perms.join(', ') : 'none'}\n`
          + 'installed but NOT loaded: it replaces the whole interface, which needs a licence\n'
          + 'that includes White Label. It loads on its own once such a licence is active.\n',
        );
        return;
      }
      // Whether the daemon will actually MOUNT it. An unsigned package is
      // installed either way (only a tampered one is refused above), but
      // saying "loads within the second" when admission will reject it sends
      // the user looking for the bug everywhere except where it is.
      const { config } = await loadDist('config/load');
      const { unsignedPluginsAllowed } = await loadDist('plugins/pubkey');
      const devMode = config().developer.unsignedPlugins;
      const admitted = result.signature.ok || unsignedPluginsAllowed(devMode);
      // The two reasons an unsigned package stays unloaded need two different
      // gestures. Ask the gate itself whether `true` would admit it: if not,
      // the licence or the lock refuses it, and switching developer mode on
      // would change nothing.
      const refusal = !unsignedPluginsAllowed(true)
        ? 'installed but NOT loaded: unsigned, and this installation refuses unsigned plugins even in\n'
          + 'developer mode (a licence with a fixed plugin composition, or Timon locked until a licence\n'
          + 'is activated). Install a signed version, or check `timon license status`.\n'
        : 'installed but NOT loaded: unsigned, and developer mode is off.\n'
          + 'Set `"developer": { "unsignedPlugins": true }` in timon.config.json to load it.\n';
      process.stdout.write(
        `${result.id}@${result.version} installed (${result.pkg})\n`
        + `permissions: ${perms.length ? perms.join(', ') : 'none'}\n`
        + (result.signature.ok
          ? `signature: valid (${result.signature.keyId})\n`
          : `signature: ${result.signature.code} — ${result.signature.message}\n`)
        + update
        + (admitted
          ? 'the daemon loads it within the second, no restart\n'
          : refusal),
      );
      for (const c of result.children) {
        const label = c.state === 'installed' ? `installed (${c.pkg})`
          : c.state === 'kept' ? `already present (${c.pkg}), left untouched`
          : 'NOT installed';
        process.stdout.write(`  ${c.id}: ${label}${c.message ? ` — ${c.message}` : ''}\n`);
      }
      return;
    }

    case 'remove': {
      const id = rest.find((a) => !a.startsWith('--'));
      if (!id) {
        process.stderr.write('usage: timon plugin remove <id>\n');
        process.exit(64);
      }
      const { pkg, children, agents, automations, webhooks, httpHosts, secretGrants, spawnApprovals, kanbanProjects, connections, connectionsFailed } = await mod.removePlugin(id);
      process.stdout.write(`${pkg} uninstalled (data and settings kept)\n`);
      // Not kept, unlike settings: a package republished under the same id must not inherit them.
      if (webhooks?.length) process.stdout.write(`webhook secrets deleted: ${webhooks.join(', ')} (a reinstall needs new ones)\n`);
      // Same reason: the hosts were consented to for this package, not for its id.
      if (httpHosts?.length) process.stdout.write(`hosts opened to it closed: ${httpHosts.join(', ')} (pluginPolicy.http.byPlugin; a reinstall must be granted them again)\n`);
      // Same reason: a grant names the id, so it would follow the next package under that id.
      if (secretGrants?.length) process.stdout.write(`vault grants withdrawn: ${secretGrants.join(', ')} (the secrets stay; a reinstall must be granted them again)\n`);
      // Same reason: these entries of the operator's file name the id.
      if (spawnApprovals?.length) process.stdout.write(`mission approval withdrawn: ${spawnApprovals.join(', ')} (pluginPolicy.spawn.approved; a reinstall must be approved again)\n`);
      if (kanbanProjects?.length) process.stdout.write(`Kanban projects no longer readable: ${kanbanProjects.join(', ')} (pluginPolicy.kanban.projects; a reinstall must be granted them again)\n`);
      // Same reason: an approved connection opens its address to whoever holds the id.
      if (connections?.length) process.stdout.write(`user connections sent back to approval, their keys deleted: ${connections.join(', ')} (after a reinstall: approve them again, their owners re-enter their keys)\n`);
      // The package is gone, so this command cannot be run again to finish the job.
      if (connectionsFailed?.length) {
        process.stderr.write(`user connections NOT sent back to approval, they may still be approved: ${connectionsFailed.join('; ')}\nAn administrator should revoke or delete them in Settings > Secrets > Connections before a package is installed under this id.\n`);
        process.exitCode = 1;
      }
      // A bundle takes with it only what it brought (§10.12): saying which
      // children left is the only way to see that a pre-existing one stayed.
      if (children.length) process.stdout.write(`children removed: ${children.join(', ')}\n`);
      // Never deleted with the plugin: the user may have kept working with them.
      if (agents?.length) process.stdout.write(`agents it created, kept: ${agents.join(', ')} (delete them from the Agents page if unwanted)\n`);
      if (automations?.routines?.length || automations?.triggers?.length) process.stdout.write(`routines and triggers it owned, switched off: ${[...automations.routines, ...automations.triggers].join(', ')} (delete or re-enable them from the Routines and Triggers pages)\n`);
      if (automations?.pipelines?.length) process.stdout.write(`pipelines it defined, kept: ${automations.pipelines.join(', ')}\n`);
      return;
    }

    case 'enable':
    case 'disable': {
      const id = rest.find((a) => !a.startsWith('--'));
      if (!id) {
        process.stderr.write(`usage: timon plugin ${sub} <id>\n`);
        process.exit(64);
      }
      mod.setPluginEnabled(id, sub === 'enable');
      process.stdout.write(`${id} ${sub === 'enable' ? 'enabled' : 'disabled'} — hot-applied\n`);
      return;
    }

    case 'sign': {
      const dir = rest.find((a) => !a.startsWith('--'));
      if (!dir) { process.stderr.write('usage: timon plugin sign <dir>\n'); process.exit(64); }
      const script = fileURLToPath(new URL('../scripts/sign-plugin.mjs', import.meta.url));
      execFileSync(process.execPath, [script, dir], { stdio: 'inherit' });
      return;
    }

    case 'verify': {
      const id = rest.find((a) => !a.startsWith('--'));
      if (!id) { process.stderr.write('usage: timon plugin verify <id>\n'); process.exit(64); }
      const found = mod.inventory().find((p) => p.id === id || p.pkg === id);
      if (!found) { process.stderr.write(`plugin not found: ${id}\n`); process.exit(1); }
      if (found.builtin && !mod.resolvePackage(id)) {
        // Trusted by the release it ships in, which the daemon checks at load.
        process.stdout.write(`${found.id} : built-in — no plugin signature; covered by the signed release, checked by the daemon when it loads it (its verdict shows in /plugins)\n`);
        return;
      }
      const discovered = mod.resolvePackage(id);
      const paths = await loadDist('paths');
      const signature = await loadDist('plugins/signature');
      const result = signature.verifyPluginDirectory(`${paths.PLUGINS_DIR}/node_modules/${discovered}`);
      if (json) process.stdout.write(JSON.stringify(result, null, 2) + '\n');
      else process.stdout.write(result.ok ? `${id} : signature valide (${result.signature.keyId})\n` : `${id} : ${result.code} — ${result.message}\n`);
      if (!result.ok) process.exitCode = 1;
      return;
    }

    default:
      process.stderr.write(`timon plugin: unknown subcommand "${sub}"\n`);
      process.exit(64);
  }
}

/**
 * `timon plugin check <dir>` — the pre-ship check of a plugin folder, before
 * sending it to someone else (TODO #643). Local and read-only: it never runs
 * the plugin's code and needs no daemon. Exit 0 nothing blocks, 1 an error (a
 * warning too under `--strict`), 64 usage.
 */
async function cmdPluginCheck(argv) {
  const args = argv.slice();
  const usage = 'usage: timon plugin check <dir> [--json] [--strict] [--deny <word>]…\n';
  const deny = takeAll(args, 'deny');
  const json = takeSwitch(args, 'json');
  const strict = takeSwitch(args, 'strict');
  const unknown = args.find((a) => a.startsWith('-'));
  if (unknown) { process.stderr.write(`timon plugin check: unknown option ${unknown}\n${usage}`); process.exit(64); }
  if (args.length !== 1 || deny.some((w) => !w || !w.trim())) { process.stderr.write(usage); process.exit(64); }
  const dir = resolvePath(args[0]);
  let isDir = false;
  try { isDir = fs.statSync(dir).isDirectory(); } catch { /* missing: same answer */ }
  if (!isDir) { process.stderr.write(`timon plugin check: ${args[0]} is not a folder\n${usage}`); process.exit(64); }
  const { checkPluginFolder, checkExitCode, formatCheckReport } = await loadDist('plugins/preship-check');
  const report = await checkPluginFolder(dir, { strict, deny, runtime: await daemonNodeRuntime() });
  process.stdout.write((json ? JSON.stringify(report, null, 2) : formatCheckReport(report)) + '\n');
  process.exitCode = checkExitCode(report);
}

/* ─── backend sign-in ─── */

function printClaudeTokenStatus(j) {
  const state = !j.configured ? 'not configured' : j.readable ? 'configured' : 'configured but unreadable (vault key changed) — set it again';
  process.stdout.write(`claude token: ${state}\n`);
  if (j.serviceOutsideSession && !j.readable) {
    process.stdout.write('warning: the service runs as a macOS LaunchDaemon; claude missions fail until a token is set.\n');
  }
}

async function cmdAuth(argv) {
  const [what, sub, ...rest] = argv;
  if (what !== 'claude-token') {
    process.stderr.write('usage: timon auth claude-token set|clear|status\n');
    process.exit(64);
  }
  if (sub === 'set') {
    // Same rule as `timon secret set`: never an argument (/proc/<pid>/cmdline, shell history).
    if (rest.length) {
      process.stderr.write('timon auth claude-token set: the token is never an argument; paste it when asked, or pipe it on stdin.\n');
      process.exit(64);
    }
    const token = (process.stdin.isTTY
      ? await readHiddenLine('Token printed by `claude setup-token`: ')
      : await readAll(process.stdin)).trim();
    if (!token) {
      process.stderr.write('timon auth claude-token set: empty token\n');
      process.exit(64);
    }
    printClaudeTokenStatus(await http('PUT', '/api/backends/claude-token', { token }));
    if (process.platform === 'darwin') {
      process.stdout.write('Run `timon service install` so Timon keeps running with no session open.\n');
    }
    return;
  }
  if (sub === 'clear') {
    printClaudeTokenStatus(await http('DELETE', '/api/backends/claude-token'));
    return;
  }
  if (sub === 'status' || sub === undefined) {
    const j = await http('GET', '/api/backends/claude-token');
    if (argv.includes('--json')) process.stdout.write(JSON.stringify(j) + '\n');
    else printClaudeTokenStatus(j);
    return;
  }
  process.stderr.write(`timon auth claude-token: unknown subcommand "${sub}" (set|clear|status)\n`);
  process.exit(64);
}

/* ─── secrets vault (SECRETS-VAULT.md §9.3) ─── */

/**
 * The value NEVER travels as an argument. `--stdin` only.
 *
 * A command line is world-readable on Linux through /proc/<pid>/cmdline for as
 * long as the process lives, and it lands in the shell history besides. Every
 * other guarantee of the vault — sealed at rest, never returned by a route,
 * redacted from transcripts — would be undone by one `timon secret set X hunter2`.
 * So a leftover positional argument is a hard error, not a convenience we
 * accept "just this once".
 */
const SECRET_VALUE_IN_ARGV =
  'timon secret set: the value is never passed as an argument.\n'
  + 'A command line is readable by any local process through /proc/<pid>/cmdline,\n'
  + 'and it stays in your shell history. Pipe it on stdin instead:\n'
  + '  printf %s "$VALUE" | timon secret set NAME --scope global --stdin\n';

async function readSecretValueFromStdin() {
  if (process.stdin.isTTY) {
    process.stderr.write('timon secret: pipe the value on stdin (--stdin), it is never an argument\n');
    process.exit(64);
  }
  // No trim: a trailing newline is stripped (shells add one), but leading and
  // inner whitespace belong to the value — some tokens are base64 blocks.
  return (await readAll(process.stdin)).replace(/\r?\n$/, '');
}

async function secretsList(target) {
  const query = [];
  if (target?.project) query.push(`project=${encodeURIComponent(target.project)}`);
  if (target?.agent) query.push(`agent=${encodeURIComponent(target.agent)}`);
  const j = await http('GET', `/api/secrets${query.length ? `?${query.join('&')}` : ''}`);
  return j.secrets || [];
}

function scopeLabel(grant) {
  return grant.scope_kind === 'global' ? 'global' : `${grant.scope_kind}:${grant.scope_ref}`;
}

/** The rows carrying this name, most specific listing first. */
async function secretsByName(name) {
  return (await secretsList()).filter((s) => s.name === name);
}

/** The single row matching this name AND this exact scope, or undefined. */
function matchScope(secrets, scope) {
  const wanted = scope === undefined ? [] : [scope];
  return secrets.find((s) => {
    const have = (s.grants || []).map(scopeLabel).sort();
    return have.length === wanted.length && have.every((g, i) => g === wanted[i]);
  });
}

async function cmdSecretList(argv) {
  const project = takeFlag(argv, 'project');
  const agent = takeFlag(argv, 'agent');
  const json = argv.includes('--json');
  const secrets = await secretsList({ project, agent });
  if (json) {
    process.stdout.write(JSON.stringify(secrets, null, 2) + '\n');
    return;
  }
  if (!secrets.length) {
    process.stdout.write('no secret\n');
    return;
  }
  for (const s of secrets) {
    const scopes = (s.grants || []).map(scopeLabel).join(', ') || 'daemon only';
    process.stdout.write(
      `${s.name.padEnd(32)} ${s.mode.padEnd(7)} ${s.configured ? 'set    ' : 'not set'} ${scopes}\n`,
    );
  }
}

async function cmdSecretSet(argv) {
  const name = argv.shift();
  const scope = takeFlag(argv, 'scope');
  const mode = takeFlag(argv, 'mode');
  const note = takeFlag(argv, 'note');
  const brokerSpec = takeFlag(argv, 'broker-spec');
  const stdinIdx = argv.indexOf('--stdin');
  const stdin = stdinIdx >= 0;
  if (stdin) argv.splice(stdinIdx, 1);
  if (!name) {
    process.stderr.write('usage: timon secret set <NAME> [--scope global|project:<slug>|agent:<name>] [--mode inject|broker] --stdin\n');
    process.exit(64);
  }
  // Anything left is a value someone tried to pass on the command line — or a
  // typo. Both deserve the same refusal, with the reason spelled out.
  if (argv.length) {
    process.stderr.write(SECRET_VALUE_IN_ARGV);
    process.exit(64);
  }
  // `--stdin` is required, not merely tolerated: reading stdin whenever it
  // happens not to be a TTY turns any pipeline the command sits in — a here-doc,
  // a `< /dev/null`, a script run under cron — into a silent source of values.
  // The flag is the operator saying "yes, the value is on this pipe".
  if (!stdin) {
    process.stderr.write(
      'timon secret set: pass --stdin and pipe the value.\n'
      + `${SECRET_VALUE_IN_ARGV}`,
    );
    process.exit(64);
  }
  const value = await readSecretValueFromStdin();
  if (!value) {
    process.stderr.write('timon secret set: empty value\n');
    process.exit(64);
  }
  const existing = matchScope(await secretsByName(name), scope);
  const payload = {
    value,
    ...(mode ? { mode } : {}),
    ...(note ? { note } : {}),
    ...(brokerSpec ? { broker_spec: JSON.parse(brokerSpec) } : {}),
  };
  const j = existing
    ? await http('PUT', `/api/secrets/${encodeURIComponent(existing.id)}`, payload)
    : await http('POST', '/api/secrets', { name, ...payload, grants: scope ? [scope] : [] });
  const scopes = (j.grants || []).map(scopeLabel).join(', ') || 'daemon only';
  process.stdout.write(`${existing ? 'replaced' : 'created'} ${j.name} (${j.mode}) — ${scopes}\n`);
}

/** `grant` and `revoke` act on a name; an ambiguous name must be resolved by
 *  the operator rather than guessed at. */
async function resolveSingleSecret(cmd, name) {
  const matches = await secretsByName(name);
  if (!matches.length) {
    process.stderr.write(`timon secret ${cmd}: unknown secret ${name}\n`);
    process.exit(4);
  }
  if (matches.length > 1) {
    process.stderr.write(
      `timon secret ${cmd}: ${matches.length} secrets are named ${name} — `
      + `scopes: ${matches.map((s) => (s.grants || []).map(scopeLabel).join('+') || 'daemon-only').join(' | ')}\n`,
    );
    process.exit(4);
  }
  return matches[0];
}

async function cmdSecretGrant(argv, revoke) {
  const verb = revoke ? 'revoke' : 'grant';
  const name = argv.shift();
  const scope = takeFlag(argv, 'scope');
  if (!name || !scope) {
    process.stderr.write(`usage: timon secret ${verb} <NAME> --scope global|project:<slug>|agent:<name>|backend:<id>\n`);
    process.exit(64);
  }
  const secret = await resolveSingleSecret(verb, name);
  const path = `/api/secrets/${encodeURIComponent(secret.id)}/grants`;
  const j = revoke
    ? await http('DELETE', `${path}?scope=${encodeURIComponent(scope)}`)
    : await http('POST', path, { scope });
  process.stdout.write(`${j.name}: ${(j.grants || []).map(scopeLabel).join(', ') || 'daemon only'}\n`);
}

async function cmdSecretRm(argv) {
  const name = argv.shift();
  if (!name) {
    process.stderr.write('usage: timon secret rm <NAME>\n');
    process.exit(64);
  }
  const secret = await resolveSingleSecret('rm', name);
  await http('DELETE', `/api/secrets/${encodeURIComponent(secret.id)}`);
  process.stdout.write(`removed ${name}\n`);
}

async function cmdSecretRekey() {
  const j = await http('POST', '/api/secrets/rekey');
  process.stdout.write(`rekeyed ${j.rotated} secret(s) — new master key staged then promoted\n`);
}

async function cmdSecretImportEnv(argv) {
  const deleteSource = argv.includes('--delete-source');
  const j = await http('POST', '/api/secrets/import-env', { deleteSource });
  process.stdout.write(
    `imported ${j.imported.length} key(s) with NO grant (daemon only)`
    + `${j.imported.length ? `: ${j.imported.join(', ')}` : ''}\n`
    + `${j.deletedSource ? 'secrets.env deleted\n' : 'secrets.env kept — pass --delete-source to remove it\n'}`,
  );
}

async function findUserBySpec(spec) {
  const data = await http('GET', '/api/users');
  const users = Array.isArray(data.users) ? data.users : [];
  const needle = String(spec).trim().toLowerCase();
  const found = users.find((u) => u.id === spec || String(u.email).toLowerCase() === needle);
  if (!found) {
    process.stderr.write(`timon: user not found: ${spec}\n`);
    process.exit(2);
  }
  return found;
}

async function cmdSetupToken() {
  const data = await http('POST', '/api/auth/setup-token');
  process.stdout.write(`${data.token}\n`);
  process.stderr.write(
    data.required
      ? 'Paste this token in the setup form. It is single use and is dropped once the first account exists.\n'
      : 'This listener is local: the setup form does not ask for it.\n',
  );
}

async function cmdUserList() {
  const data = await http('GET', '/api/users');
  process.stdout.write(JSON.stringify(data.users ?? [], null, 2) + '\n');
}

async function cmdUserResetPassword(argv) {
  const spec = argv[0];
  if (!spec) {
    process.stderr.write('usage: timon user reset-password <email-or-id>\n');
    process.exit(64);
  }
  const user = await findUserBySpec(spec);
  const data = await http('POST', `/api/users/${encodeURIComponent(user.id)}/reset-password`);
  process.stdout.write(
    `Temporary password for ${user.email}:\n${data.password}\n`
    + 'Communicate it out of band. It will not be shown again.\n',
  );
}

/* ─── subscription accounts (TODO #330) ─── */

async function findBackendAccount(spec) {
  const data = await http('GET', '/api/backends/accounts');
  const accounts = Array.isArray(data.accounts) ? data.accounts : [];
  const found = accounts.find((a) => a.id === spec || a.instance === spec);
  if (!found) {
    process.stderr.write(`timon: subscription account not found: ${spec}\n`);
    process.exit(2);
  }
  return found;
}

async function cmdBackendAccountList(argv) {
  const data = await http('GET', '/api/backends/accounts');
  const accounts = Array.isArray(data.accounts) ? data.accounts : [];
  if (argv.includes('--json')) {
    process.stdout.write(JSON.stringify(accounts, null, 2) + '\n');
    return;
  }
  if (!accounts.length) {
    process.stdout.write('No subscription account.\n');
    return;
  }
  const users = await http('GET', '/api/users').then((r) => (Array.isArray(r.users) ? r.users : [])).catch(() => []);
  const label = (id) => users.find((u) => u.id === id)?.email ?? id;
  for (const a of accounts) {
    const owner = a.ownerUserId === null ? 'instance' : label(a.ownerUserId);
    process.stdout.write(`${a.instance.padEnd(24)} ${a.name}  [${a.state}${a.connected ? '' : ', not signed in'}]  owner: ${owner}\n`);
    if (Array.isArray(a.grantedTo) && a.grantedTo.length) {
      process.stdout.write(`  assigned to: ${a.grantedTo.map(label).join(', ')}\n`);
    }
  }
}

/** The daemon route replaces the whole list: read it, change it, send it back. */
async function cmdBackendAccountGrant(argv, revoke) {
  const verb = revoke ? 'revoke' : 'grant';
  const spec = argv[0];
  const usersFlag = takeFlag(argv, 'user');
  if (!spec || spec.startsWith('--') || !usersFlag) {
    process.stderr.write(`usage: timon backend-account ${verb} <id> --user EMAIL-OR-ID[,…]\n`);
    process.exit(64);
  }
  const account = await findBackendAccount(spec);
  if (!Array.isArray(account.grantedTo)) {
    process.stderr.write('timon: only the superadmin assigns subscription accounts\n');
    process.exit(1);
  }
  const wanted = new Set(account.grantedTo);
  for (const userSpec of usersFlag.split(',').map((x) => x.trim()).filter(Boolean)) {
    const user = await findUserBySpec(userSpec);
    if (revoke) wanted.delete(user.id);
    else if (user.id !== account.ownerUserId) wanted.add(user.id);
  }
  const data = await http('PUT', `/api/backends/accounts/${encodeURIComponent(account.id)}/grants`, { userIds: [...wanted] });
  process.stdout.write(JSON.stringify({ id: data.account.id, instance: data.account.instance, grantedTo: data.account.grantedTo ?? [] }) + '\n');
}

async function cmdBackendAccount(argv) {
  const [sub, ...rest] = argv;
  switch (sub) {
    case 'list':
    case undefined:
      return cmdBackendAccountList(rest);
    case 'grant':
      return cmdBackendAccountGrant(rest, false);
    case 'revoke':
      return cmdBackendAccountGrant(rest, true);
    default:
      process.stderr.write('usage: timon backend-account list|grant|revoke …\n');
      process.exit(64);
  }
}

async function cmdUser(argv) {
  const [sub, ...rest] = argv;
  switch (sub) {
    case 'list':
      return cmdUserList();
    case 'reset-password':
      return cmdUserResetPassword(rest);
    default:
      process.stderr.write('usage: timon user list|reset-password …\n');
      process.exit(64);
  }
}

async function cmdSecret(argv) {
  const [sub, ...rest] = argv;
  switch (sub) {
    case 'list':
    case undefined:
      return cmdSecretList(rest);
    case 'set':
      return cmdSecretSet(rest);
    case 'grant':
      return cmdSecretGrant(rest, false);
    case 'revoke':
      return cmdSecretGrant(rest, true);
    case 'rm':
    case 'delete':
      return cmdSecretRm(rest);
    case 'rekey':
      return cmdSecretRekey();
    case 'import-env':
      return cmdSecretImportEnv(rest);
    default:
      process.stderr.write('usage: timon secret <list|set|grant|revoke|rm|rekey|import-env> …\n');
      process.exit(64);
  }
}

async function cmdLicense(argv) {
  if (argv[0] === 'deactivate') {
    const response = await fetch(`${API}/api/license/deactivate`, { method: 'POST', headers: timonHeaders() });
    const result = await response.json();
    if (!response.ok) throw new Error(result.message || result.error || `HTTP ${response.status}`);
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
    // The server keeps the seat leased until this machine's last token expires
    // (contract §5): say so, or the next `activate` elsewhere looks broken.
    process.stdout.write('This machine is released. The seat transfers once its last token lease expires; '
      + 'activating another machine before that answers transfer_pending with the exact time to retry.\n');
    return;
  }
  const [sub, file] = argv;
  if (sub === 'status' || sub === undefined) {
    const response = await fetch(`${API}/api/license`, { headers: timonHeaders() });
    const body = await response.json();
    if (!response.ok) throw new Error(body.error || `HTTP ${response.status}`);
    process.stdout.write(`${body.status} — edition ${body.edition}${body.expiresAt ? ` — expires ${body.expiresAt}` : ''}\n`);
    return;
  }
  if (sub === 'install') {
    if (!file) { process.stderr.write('usage: timon license install <file>\n'); process.exit(64); }
    const token = fs.readFileSync(file, 'utf8').trim();
    const response = await fetch(`${API}/api/license`, {
      method: 'PUT',
      headers: { ...timonHeaders(), 'content-type': 'application/json' },
      body: JSON.stringify({ token }),
    });
    const body = await response.json();
    if (!response.ok) {
      // A token minted for another machine is the common paste mistake: name
      // the device this daemon expects, or the operator has nothing to act on.
      const device = body.device ? ` — this device is ${body.device}` : '';
      throw new Error(`${body.error || 'license refused'} (${body.reason || response.status})${device}`);
    }
    process.stdout.write(`license installed — ${body.status}, edition ${body.edition}\n`);
    return;
  }
  if (sub === 'activate') {
    // Unlike `install`, the second argument is the short activation KEY
    // (`TMN-XXXX-…`), not a file: the daemon exchanges it with the license
    // server for a JWT over `/api/license/activate` and installs that.
    const key = file;
    if (!key) { process.stderr.write('usage: timon license activate <key>\n'); process.exit(64); }
    const response = await fetch(`${API}/api/license/activate`, {
      method: 'POST',
      headers: { ...timonHeaders(), 'content-type': 'application/json' },
      body: JSON.stringify({ key }),
    });
    const body = await response.json();
    if (!response.ok) {
      const device = body.device ? ` — this device is ${body.device}` : '';
      const message = body.message ? ` — ${body.message}` : '';
      const retryAt = typeof body.body?.retry_at === 'number' ? ` — retry from ${new Date(body.body.retry_at * 1000).toLocaleString()}` : '';
      throw new Error(`${body.error || 'activation refused'} (${body.reason || response.status})${message}${device}${retryAt}`);
    }
    process.stdout.write(`license installed — ${body.status}, edition ${body.edition}\n`);
    return;
  }
  process.stderr.write('usage: timon license status|install <file>|activate <key>\n');
  process.exit(64);
}

/** Yes/no question on the TTY. Without a TTY (agent, script), refuse rather
 *  than assume "yes": granting permissions by default would be worse. */
async function confirm(question) {
  if (!process.stdin.isTTY) {
    process.stderr.write(question + '\n(no interactive terminal: rerun with --yes)\n');
    return false;
  }
  const readline = await import('node:readline/promises');
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  try {
    const answer = (await rl.question(question)).trim().toLowerCase();
    return answer === 'o' || answer === 'oui' || answer === 'y' || answer === 'yes';
  } finally {
    rl.close();
  }
}

/**
 * `/api/update/<action>` of THIS home's daemon, authenticated by its update
 * token. This capability belongs to this home; never send it to a profile or
 * TIMON_API URL.
 */
async function updateRequest(action, body, timeoutMs = 180_000) {
  const target = new URL(resolveApiUrl(timonHome()));
  const port = Number(process.env.PORT);
  if (Number.isInteger(port) && port > 0 && port < 65536) target.port = String(port);
  const token = fs.readFileSync(join(timonHome(), 'update-token'), 'utf8').trim();
  return fetch(new URL(`/api/update/${action}`, target), {
    method: body ? 'POST' : 'GET', redirect: 'error',
    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
    ...(body ? { body: JSON.stringify(body) } : {}),
    signal: AbortSignal.timeout(timeoutMs),
  });
}

/** The version the daemon of this home reports, `null` when none answers. */
async function runningDaemonVersion() {
  try {
    const response = await updateRequest('status', undefined, 5000);
    if (!response.ok) return null;
    const body = await response.json();
    return typeof body.daemonVersion === 'string' ? body.daemonVersion : null;
  } catch {
    return null;
  }
}

/** A packaged CLI newer than the daemon it talks to: the service was left on the previous release. */
async function serviceLagFor(daemonVersion) {
  // Only a package has a version of its own to compare; a source CLI loads nothing more.
  if (!PACKAGED_RUNTIME) return null;
  const { serviceLag } = await loadDist('host/packaged-apply');
  const { timonVersion } = await loadDist('data-version');
  return serviceLag({
    platform: process.platform, packaged: PACKAGED_RUNTIME,
    cliVersion: timonVersion(), daemonVersion,
  });
}

/** Human text of `GET|POST /api/updates` (`plugins-bundled/updates/checker.ts`). */
function updateCheckText(status) {
  const where = `channel ${status.channel}`;
  switch (status.state) {
    case 'off': return `Update checks are turned off (TIMON_UPDATES_CHECK). Timon ${status.installed}, ${where}.`;
    case 'dev': return `This build runs from the sources: it does not check for updates (Timon ${status.installed}).`;
    case 'up_to_date': return `Timon ${status.installed} is up to date (${where}).`;
    case 'unchecked': return `No check has run yet (Timon ${status.installed}, ${where}).`;
    case 'available': {
      const offer = status.available;
      const installers = offer.artifacts.map((a) => `  ${a.key.padEnd(20)} ${a.url}`).join('\n');
      return [
        `Timon ${offer.version} is available (you run ${status.installed}, ${where}; published ${offer.publishedAt.slice(0, 10)}).`,
        '', offer.notes.trim(), '',
        'Installers:', installers,
        `Release notes: ${offer.notesUrl}`,
      ].join('\n');
    }
    default: return `No update known: the release list could not be read or verified (see the daemon log). Timon ${status.installed}, ${where}.`;
  }
}

async function cmdUpdateCheck(flags) {
  if (flags.some((flag) => flag !== '--json')) throw new Error('Usage: timon update check [--json]');
  const status = await http('POST', '/api/updates/check', {});
  process.stdout.write(`${flags.includes('--json') ? JSON.stringify(status, null, 2) : updateCheckText(status)}\n`);
  if (status.state === 'failed') process.exitCode = 1;
}

async function cmdUpdate(rest, daemonSpec) {
  // Asks a daemon over its API, so it works on a remote one as well (`--daemon`).
  if (rest[0] === 'check') return cmdUpdateCheck(rest.slice(1));
  const [action, version] = rest;
  if (!['status', 'approve', 'apply'].includes(action) || (action === 'approve' && !version)
    || rest.length > (action === 'approve' ? 2 : 1)) {
    throw new Error('Usage: timon update check [--json] | timon update status | timon update apply | timon update approve <daemon-version>');
  }
  if (daemonSpec !== undefined) throw new Error('Run timon update on the daemon host, using its TIMON_HOME.');
  if (action === 'apply') {
    const result = await applyPackagedUpdate();
    process.stdout.write(`${result.lines.join('\n')}\n`);
    if (result.code !== 0) process.exitCode = result.code;
    return;
  }
  const response = await updateRequest(action, action === 'approve' ? { version, approve: true } : undefined);
  const body = await response.json();
  const lag = action === 'status' && response.ok ? await serviceLagFor(body.daemonVersion) : null;
  if (lag) {
    body.installedPackage = lag;
    const { serviceLagMessage } = await loadDist('host/packaged-apply');
    process.stderr.write(`${serviceLagMessage(lag, body.daemonVersion)}\n`);
  }
  process.stdout.write(`${JSON.stringify(body, null, 2)}\n`);
  if (!response.ok) process.exitCode = 1;
}

/**
 * Moves the installed service onto this package: the desktop's upgrade
 * runner, launched from a terminal (`host/packaged-apply.ts`). `allowOlder`:
 * `timon service install` may put an older package back on purpose.
 * The generic host, never `host/index`: it reaches db.ts, which refuses to
 * load while this very update waits for approval.
 */
async function applyPackagedUpdate({ allowOlder = false } = {}) {
  const { config } = await loadDist('config/load');
  const { createGenericHost } = await loadDist('host/generic');
  const { markPackagedCli, serviceOptsFromEnvironment } = await loadDist('host/service-environment');
  const { readServiceDefinition } = await loadDist('host/service-install');
  const { serviceOfAnotherHome } = await loadDist('host/service-ownership');
  const { readActiveRelease } = await loadDist('host/packaged-service');
  const { applyServiceUpdate } = await loadDist('host/packaged-apply');
  const { timonVersion } = await loadDist('data-version');
  const { TIMON_HOME } = await loadDist('paths');
  const cliVersion = timonVersion();
  // Before `config()`: the first-launch ports and the packaged unit name go through it.
  markPackagedCli(process.env, process.versions, cliVersion, TIMON_HOME);
  const cfg = config();
  const host = createGenericHost(cfg);
  const opts = serviceOptsFromEnvironment(cfg, () => host);
  return applyServiceUpdate({
    platform: process.platform,
    packaged: PACKAGED_RUNTIME,
    cliVersion,
    daemonVersion: await runningDaemonVersion(),
    activeRelease: await readActiveRelease(TIMON_HOME),
    // The name is shared: one that names another home is not this directory's service.
    serviceInstalled: readServiceDefinition(opts) !== null && serviceOfAnotherHome(opts) === null,
    allowOlder,
  }, {
    platform: process.platform,
    home: TIMON_HOME,
    cliVersion,
    execPath: process.execPath,
    installDir: cfg.daemon.installDir,
    daemonPort: cfg.daemon.listen.port,
    appEnabled: cfg.app.enabled,
    appPort: cfg.app.listen.port,
    path: process.env.PATH,
    now: Date.now(),
  });
}

/** `timon doctor` — always local: the diagnostic covers THIS machine,
 *  which isn't necessarily the one running a daemon. */
async function cmdDoctor(argv) {
  if (argv.includes('--report')) return cmdDoctorReport(argv);
  // A packaged CLI refuses to open data an unapproved update would migrate
  // (db.ts, TODO #535): the findings below, built without the database, still say what to do.
  let doctor;
  try {
    doctor = await loadDist('doctor');
  } catch (e) {
    if (e?.name !== 'PackagedCliUpdatePendingError') throw e;
    doctor = {
      diagnose: () => ({ ok: false, updatePending: e.message }),
      formatDoctor: (report) => `Update pending: ${report.updatePending}\n`,
    };
  }
  const { diagnose, formatDoctor } = doctor;
  const report = diagnose();
  const backendProfiles = await backendProfilesReport({
    // A section read through the route, not `diagnose()`: a CLI process loads
    // no provider, so only the daemon can tell which profiles really run.
    local: isLocalDaemonUrl(timonHome(), API, { packaged: packagedCli() }),
    fetchListing: () => httpRaw('GET', '/api/backends/custom', undefined, 5000),
    loadLocalProfiles: () => loadDist('backends/local-profiles'),
  });
  if (argv.includes('--json')) {
    process.stdout.write(JSON.stringify({ ...report, backendProfiles }, null, 2) + '\n');
  } else {
    process.stdout.write(formatDoctor(report));
    process.stdout.write(`\n${formatBackendProfiles(backendProfiles)}`);
    // The named traps of the support report (TODO #343): unmarked service,
    // a task that never ran, data behind the version, a foreign port.
    const { findings } = await diagnosticReport();
    const daemonVersion = PACKAGED_RUNTIME ? await runningDaemonVersion() : null;
    const lag = await serviceLagFor(daemonVersion);
    if (lag) {
      const { serviceLagMessage } = await loadDist('host/packaged-apply');
      findings.push({ id: 'service-behind-package', text: serviceLagMessage(lag, daemonVersion) });
    }
    process.stdout.write(findings.length
      ? `\nFindings:\n${findings.map((finding) => `  - ${finding.text}`).join('\n')}\n`
      : '\nFindings: none detected.\n');
  }
  if (!report.ok) process.exit(1);
}

/** The report the app's error boxes copy, built here without the database:
 *  it must work while an update waits for approval or the daemon is down. */
async function diagnosticReport() {
  const { reportFromEnvironment } = await loadDist('host/diagnostic-report');
  const { markPackagedCli } = await loadDist('host/service-environment');
  const { timonVersion } = await loadDist('data-version');
  const { TIMON_HOME } = await loadDist('paths');
  // Same service lookup as `timon service status` from the app's terminal.
  markPackagedCli(process.env, process.versions, timonVersion(), TIMON_HOME);
  return reportFromEnvironment({ source: 'cli', home: TIMON_HOME, appVersion: null });
}

async function cmdDoctorReport(argv) {
  const args = argv.slice();
  const save = takeFlag(args, 'save');
  const { text } = await diagnosticReport();
  if (!save) { process.stdout.write(text); return; }
  fs.writeFileSync(resolvePath(save), text);
  process.stdout.write(`Diagnostic report saved to ${resolvePath(save)}\n`);
}

/** `timon logs` — the dated log files, newest line first (the files stay chronological). */
async function cmdLogs(argv) {
  const args = argv.slice();
  const short = args.indexOf('-n');
  const count = Number(takeFlag(args, 'lines') ?? (short >= 0 ? args.splice(short, 2)[1] : undefined) ?? 100);
  if (!Number.isInteger(count) || count <= 0) { process.stderr.write('usage: timon logs [--desktop|--prompts|--supervisor] [-n N]\n'); process.exit(64); }
  const { logDir, readRecentLines, supervisorLogFile, tailLines } = await loadDist('log-file');
  const { TIMON_HOME } = await loadDist('paths');
  const dir = logDir(TIMON_HOME);
  const lines = args.includes('--supervisor')
    ? tailLines(supervisorLogFile(TIMON_HOME), count).reverse()
    : readRecentLines(dir, args.includes('--desktop') ? 'desktop' : args.includes('--prompts') ? 'prompts' : 'daemon', count);
  process.stdout.write(lines.length ? lines.join('\n') + '\n' : `No log lines in ${dir}\n`);
}

async function cmdTrace(argv) {
  const json = argv.includes('--json');
  const days = takeFlag(argv, 'days');
  if (argv[0] === 'backfill') {
    if (days !== undefined && (!/^\d+(?:\.\d+)?$/.test(days) || Number(days) < 0)) {
      process.stderr.write('usage: timon trace backfill [--days N]\n'); process.exit(64);
    }
    const result = await http('POST', '/api/trace/backfill', days === undefined ? {} : { days: Number(days) });
    process.stdout.write(JSON.stringify(result, null, 2) + '\n');
    return;
  }
  const id = argv.find((arg) => arg !== '--json');
  if (!id) { process.stderr.write('usage: timon trace <traceId|missionId> [--json]\n'); process.exit(64); }
  const result = await http('GET', `/api/trace/${encodeURIComponent(id)}`);
  if (json) { process.stdout.write(JSON.stringify(result, null, 2) + '\n'); return; }
  process.stdout.write(`trace ${result.trace_id} — ${result.aggregates.missions} mission(s), ${result.aggregates.tools} tool(s)\n`);
  if (result.spans_truncated) process.stdout.write(`(showing the latest ${result.spans.length} of ${result.spans_total} spans)\n`);
  for (const mission of result.missions) {
    process.stdout.write(`├─ ${mission.agent_name}  ${mission.status}  ${mission.id}\n`);
    for (const span of result.spans.filter((s) => s.mission_id === mission.id)) {
      const time = new Date(span.started_at).toISOString().slice(11, 19);
      const duration = span.duration_ms == null ? '—' : span.duration_ms >= 1000 ? `${(span.duration_ms / 1000).toFixed(1)}s` : `${span.duration_ms}ms`;
      const tokens = span.tokens_in != null || span.tokens_out != null ? ` ${span.tokens_in ?? 0}/${span.tokens_out ?? 0} tok` : '';
      process.stdout.write(`│  ${time}  ${span.kind}  ${span.name}  ${span.status}  ${duration}${tokens}\n`);
    }
  }
}

/**
 * CLI profiles (4.2b) — local file, the daemon doesn't need to be running.
 * The token is never printed: `list` only shows name + url.
 */
async function cmdDaemon(argv) {
  const [sub, name, url, ...tokenParts] = argv;
  if (sub === 'add') {
    const token = tokenParts.join(' ');
    if (!name || !url || !token) {
      process.stderr.write('usage: timon daemon add <name> <url> <token>\n');
      process.exit(64);
    }
    if (!validDaemonName(name)) {
      process.stderr.write('timon daemon add: invalid name (A-Za-z0-9._@+- only, no ..)\n');
      process.exit(64);
    }
    if (!isHttpUrl(url)) {
      process.stderr.write('timon daemon add: url must start with http:// or https://\n');
      process.exit(64);
    }
    const tok = token.trim();
    if (!tok) {
      process.stderr.write('timon daemon add: empty token\n');
      process.exit(64);
    }
    const file = cliDaemonsPath();
    fs.mkdirSync(dirname(file), { recursive: true });
    const daemons = loadCliDaemons();
    daemons[name] = { url: stripTrailingSlash(url), token: tok };
    const tmp = `${file}.tmp`;
    fs.writeFileSync(tmp, JSON.stringify(daemons, null, 2) + '\n', { encoding: 'utf8', mode: 0o600 });
    try { fs.chmodSync(tmp, 0o600); } catch { /* FS without Unix permissions */ }
    fs.renameSync(tmp, file);
    try { fs.chmodSync(file, 0o600); } catch { /* FS without Unix permissions */ }
    process.stdout.write(`daemon '${name}' registered (${daemons[name].url})\n`);
    return;
  }
  if (sub === 'list') {
    const daemons = loadCliDaemons();
    const names = Object.keys(daemons);
    if (names.length === 0) {
      process.stdout.write('(no profile — timon daemon add <name> <url> <token>)\n');
      return;
    }
    for (const n of names) {
      const p = daemons[n];
      const u = p && typeof p === 'object' && typeof p.url === 'string' ? p.url : '?';
      process.stdout.write(`${n}  ${u}\n`);
    }
    return;
  }
  process.stderr.write(
    'usage: timon daemon list\n'
    + '       timon daemon add <name> <url> <token>\n',
  );
  process.exit(64);
}

/* ── git credential helper (SECRETS-VAULT.md §6.2) ────────────────────────── */

/**
 * `timon git-credential <get|store|erase>` — git's credential protocol.
 *
 * Configure it with, in the repository that needs it:
 *
 *   git config credential.helper "timon git-credential"
 *
 * git then spawns THIS process, writes `protocol=`/`host=`/`path=` lines on its
 * stdin, and reads `username=`/`password=` lines back. The token therefore
 * never appears in a command line, in a remote URL, or in the agent's
 * environment — the three places it actually leaks from in practice.
 *
 * What this does NOT buy, stated plainly: an agent can run this command itself
 * and read the answer. The vault defends against the accident, never against a
 * hostile agent (SECRETS-VAULT.md §2), and pretending otherwise would be worse
 * than not having it.
 *
 * Silence is the contract. A host with no matching identity, a missing grant or
 * an unreachable daemon all exit 0 with nothing on stdout: git then falls
 * through to its other helpers, exactly as if we had never been configured.
 * Only credential lines go to stdout; everything else goes to stderr.
 */
async function cmdGitCredential(args) {
  const op = args[0];
  // `store` and `erase` are no-ops on purpose: the vault is the only store, and
  // git must not be able to write into it or wipe an entry from it.
  if (op !== 'get') return;

  const input = await readAllStdin();
  const fields = {};
  for (const line of input.split('\n')) {
    const eq = line.indexOf('=');
    if (eq <= 0) continue;
    fields[line.slice(0, eq).trim()] = line.slice(eq + 1).trim();
  }
  const host = fields.host ? fields.host.split(':')[0] : '';
  if (!host) return;
  // git also probes for `git://`, `ssh://`… where a password means nothing.
  if (fields.protocol && fields.protocol !== 'https') return;

  let answer;
  try {
    const r = await httpRaw('POST', '/api/secrets/broker/git', { host, path: fields.path });
    if (!r.ok) return; // 403/404 → we simply have nothing to say about this host
    answer = r.body;
  } catch {
    return; // daemon down: git keeps its other helpers
  }
  if (!answer || typeof answer.password !== 'string') return;
  process.stdout.write(`username=${answer.username}\npassword=${answer.password}\n\n`);
}

function readAllStdin() {
  return new Promise((resolve) => {
    let data = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (chunk) => { data += chunk; });
    process.stdin.on('end', () => resolve(data));
    process.stdin.on('error', () => resolve(data));
  });
}

async function main() {
  const argv = process.argv.slice(2);
  const daemonSpec = takeFlag(argv, 'daemon');
  if (daemonSpec !== undefined) {
    if (!daemonSpec) {
      process.stderr.write('usage: timon --daemon <url|name> <command> …\n');
      process.exit(64);
    }
    applyDaemonTarget(daemonSpec);
  } else {
    // The token follows the resolved target: TIMON_API pointing elsewhere must
    // not carry this home's daemon-token with it.
    API = resolveApiUrl(timonHome(), process.env.TIMON_API, undefined, { packaged: packagedCli() });
    API_TOKEN = resolveApiToken(API);
  }
  const [cmd, ...rest] = argv;
  try {
    switch (cmd) {
      case 'update':
        await cmdUpdate(rest, daemonSpec);
        break;
      case 'list':
        await cmdList();
        break;
      case 'spawn':
        await cmdSpawn(rest);
        break;
      case 'send':
        await cmdSend(rest);
        break;
      case 'steer':
        await cmdSteer(rest);
        break;
      case 'wait':
        await cmdWait(rest);
        break;
      case 'status':
        await cmdStatus(rest);
        break;
      case 'kill':
        await cmdKill(rest);
        break;
      case 'stop':
        await cmdStop(rest);
        break;
      case 'agent':
        await cmdAgent(rest);
        break;
      case 'mission':
        await cmdMission(rest);
        break;
      case 'skill':
        await cmdSkill(rest);
        break;
      case 'mcp':
        await cmdMcp(rest);
        break;
      case 'task':
        await cmdTask(rest);
        break;
      case 'series':
        await cmdSeries(rest);
        break;
      case 'backends':
        await cmdBackends(rest);
        break;
      case 'worktree':
        await cmdWorktree(rest);
        break;
      case 'project':
        await cmdProject(rest);
        break;
      case 'workspace':
        await cmdWorkspace(rest);
        break;
      case 'msg':
        await cmdMsg(rest);
        break;
      case 'pipeline':
        await cmdPipeline(rest);
        break;
      case 'memory':
        await cmdMemory(rest);
        break;
      case 'routine':
        await cmdRoutine(rest);
        break;
      case 'trigger':
        await cmdTrigger(rest);
        break;
      case 'notify':
        await cmdNotify(rest);
        break;
      case 'project-todo':
      // Deprecated name, kept so scripts written before the rename keep working.
      case 'todo-later':
        await cmdProjectTodo(rest);
        break;
      case 'browser':
        await cmdBrowser(rest);
        break;
      case 'git-credential':
        await cmdGitCredential(rest);
        break;
      case 'health':
        await cmdHealth(rest);
        break;
      case 'export':
        await cmdExport(rest);
        break;
      case 'import':
        await cmdImport(rest);
        break;
      case 'docs':
        await cmdDocs(rest);
        break;
      case 'backup':
        await cmdBackup(rest);
        break;
      case 'widgets':
        await cmdWidgets(rest);
        break;
      case 'islands':
        await cmdIslands(rest);
        break;
      case 'navigate':
        await cmdNavigate(rest);
        break;
      case 'nav':
        await cmdNav(rest);
        break;
      case 'ui-doc':
        await cmdUiDoc(rest);
        break;
      case 'onboarding':
        await cmdOnboarding(rest);
        break;
      case 'setup':
        await cmdSetup(rest);
        break;
      case 'doctor':
        await cmdDoctor(rest);
        break;
      case 'logs':
        await cmdLogs(rest);
        break;
      case 'trace':
        await cmdTrace(rest);
        break;
      case 'workflow':
        await cmdWorkflow(rest);
        break;
      case 'plugin':
        await cmdPlugin(rest);
        break;
      case 'app':
        await cmdApp(rest);
        break;
      case 'module':
        await cmdModule(rest);
        break;
      case 'service':
        await cmdService(rest);
        break;
      case 'init':
        await cmdInit(rest, daemonSpec !== undefined);
        break;
      case 'setup-token':
        await cmdSetupToken();
        break;
      case 'user':
        await cmdUser(rest);
        break;
      case 'backend-account':
        await cmdBackendAccount(rest);
        break;
      case 'backend':
        await cmdBackend(rest, {
          httpRaw,
          readAll,
          readHiddenLine,
          stdin: process.stdin,
          out: (text) => process.stdout.write(text),
          err: (text) => process.stderr.write(text),
          exit: (code) => process.exit(code),
        });
        break;
      case 'secret':
        await cmdSecret(rest);
        break;
      case 'auth':
        await cmdAuth(rest);
        break;
      case 'license':
        await cmdLicense(rest);
        break;
      case 'daemon':
        await cmdDaemon(rest);
        break;
      case 'device':
        await cmdDevice(rest, {
          http,
          httpRaw,
          findUser: findUserBySpec,
          takeFlag,
          out: (text) => process.stdout.write(text),
          err: (text) => process.stderr.write(text),
          exit: (code) => process.exit(code),
        });
        break;
      case undefined:
        await cmdOverview(daemonSpec !== undefined);
        break;
      case 'help':
      case '-h':
      case '--help':
        help();
        break;
      default:
        process.stderr.write(`timon: unknown command "${cmd}"\n`);
        help();
        process.exit(64);
    }
  } catch (e) {
    // 128 + SIGINT, what a shell reports for Ctrl-C. The person asked for it: nothing to explain.
    if (e?.code === PROMPT_CANCELLED) process.exit(130);
    if (isDaemonUnreachable(e)) {
      const local = daemonSpec === undefined && isLocalDaemonUrl(timonHome(), API, { packaged: packagedCli() });
      const lines = unreachableLines({ api: API, local, serviceInstalled: local && serviceInstalledMarker() });
      process.stderr.write(lines.join('\n') + '\n');
      process.exit(1);
    }
    process.stderr.write('timon: ' + (e && e.message ? e.message : String(e)) + '\n');
    process.exit(1);
  }
}

main();
