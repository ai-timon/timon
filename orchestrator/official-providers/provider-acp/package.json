{
  "name": "@timon-ai/provider-acp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "timon": {
    "id": "provider-acp",
    "apiVersion": 12,
    "kind": "provider",
    "label": "ACP agents (opencode, Hermes, Antigravity)",
    "description": "Runs missions on opencode, Hermes or Google Antigravity over the Agent Client Protocol, with the agent's own sign-in and providers.",
    "author": "Timon",
    "permissions": ["backends:register"],
    "provider": {
      "binaries": [
        {
          "name": "opencode"
        },
        {
          "name": "hermes-acp"
        },
        {
          "name": "hermes"
        },
        {
          "name": "agy"
        }
      ],
      "credentialDirs": [
        ".config/opencode",
        ".local/share/opencode",
        ".hermes",
        ".gemini/antigravity-cli"
      ],
      "backends": [
        {
          "id": "opencode",
          "rank": 50,
          "binary": {
            "names": [
              "opencode"
            ],
            "install": {
              "any": {
                "kind": "npm",
                "package": "opencode-ai"
              }
            },
            "searchDirs": {
              "any": [
                "~/.opencode/bin"
              ],
              "win32": [
                "${SCOOP}/shims|~/scoop/shims",
                "${ChocolateyInstall}/bin|${ProgramData}/chocolatey/bin"
              ]
            },
            "standaloneInstaller": {
              "label": "opencode",
              "posix": "curl -fsSL https://opencode.ai/install | bash"
            }
          },
          "credentialDirs": [
            ".config/opencode",
            ".local/share/opencode"
          ],
          "setupCard": {
            "label": "opencode",
            "order": 5
          },
          "installDocs": "https://opencode.ai/docs/",
          "updateCheck": {
            "latest": {
              "npm": "opencode-ai"
            },
            "supportedMajor": 1
          }
        },
        {
          "id": "hermes",
          "rank": 60,
          "binary": {
            "names": [
              "hermes-acp",
              "hermes"
            ],
            "install": {
              "any": {
                "kind": "none"
              }
            },
            "searchDirs": {
              "win32": [
                "${LOCALAPPDATA}/hermes/bin",
                "${LOCALAPPDATA}/hermes/hermes-agent/bin"
              ]
            }
          },
          "credentialDirs": [
            ".hermes"
          ],
          "setupCard": {
            "label": "Hermes",
            "order": 6
          },
          "installDocs": "https://hermes-agent.nousresearch.com/docs/getting-started/installation"
        },
        {
          "id": "antigravity",
          "rank": 75,
          "binary": {
            "names": [
              "agy"
            ],
            "install": {
              "any": {
                "kind": "script",
                "posix": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
                "windows": "irm https://antigravity.google/cli/install.ps1 | iex"
              }
            },
            "searchDirs": {
              "win32": [
                "${LOCALAPPDATA}/agy/bin"
              ]
            },
            "standaloneInstaller": {
              "label": "Antigravity",
              "posix": "curl -fsSL https://antigravity.google/cli/install.sh | bash",
              "windows": "irm https://antigravity.google/cli/install.ps1 | iex"
            }
          },
          "credentialDirs": [
            ".gemini/antigravity-cli"
          ],
          "signInCommand": "agy acp --login",
          "setupCard": {
            "label": "Antigravity",
            "order": 8
          },
          "installDocs": "https://antigravity.google/docs/getting-started?tab=cli"
        }
      ]
    },
    "license": { "required": false }
  }
}
